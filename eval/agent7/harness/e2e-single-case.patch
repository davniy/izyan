--- a/tests/test_single_case.py
+++ b/tests/test_single_case.py
@@ -0,0 +1,322 @@
+"""Single-case controller files: --benchmark-file/--prompt-file overrides and
+the controller-only ``snapshot_path`` task field (agent7 research lane).
+
+Contract (e2e-slice1-design.md §2/§6):
+- ``--benchmark-file`` replaces the named BENCHMARKS registry entry for one
+  invocation; ``--prompt-file`` replaces the PROMPTS registry template.
+- A provided file must exist and be readable — otherwise fail closed.
+- ``snapshot_path`` selects the source tree directly (no owner/repo layout)
+  and is NEVER rendered into the agent prompt.
+- All four identity placeholders — {task_id}, {cve_id}, {repo_url},
+  {commit_sha} — are rendered; that is the complete allowlist.
+"""
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+import pytest
+from pydantic import ValidationError
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+from evaluate import metrics as metrics_mod  # noqa: E402
+from evaluate import parse as parse_mod  # noqa: E402
+from evaluate import run as runmod  # noqa: E402
+from evaluate.common import (  # noqa: E402
+    ExperimentConfig,
+    config_from_args,
+    load_tasks,
+)
+
+
+def _run_parser() -> argparse.ArgumentParser:
+    """Mirror of ``evaluate run``'s parser registration in run.py."""
+    parser = argparse.ArgumentParser(prog="vex-bench evaluate run")
+    subs = parser.add_subparsers(dest="evaluate_cmd", required=True)
+    runmod.register_parser(subs)
+    return parser
+
+
+def _config(args: list[str]) -> ExperimentConfig:
+    return config_from_args(_run_parser().parse_args(args))
+
+
+def _one_case(snapshot: Path) -> dict:
+    return {
+        "task_id": "research-smoke1",
+        "cve_id": "CVE-2099-0001",
+        "repo_url": "https://local.invalid/research",
+        "commit_sha": "deadbeef" * 5,
+        "snapshot_path": str(snapshot),
+        "metadata": {"language": "go"},
+    }
+
+
+def _write_one_case(path: Path, task: dict) -> Path:
+    path.write_text(json.dumps(task) + "\n", encoding="utf-8")
+    return path
+
+
+class _FakeAgent:
+    """Records the prompt/ctx handed to run(); no docker, no model call."""
+
+    def __init__(self) -> None:
+        self.seen: list[tuple[str, object]] = []
+
+    def load_result(self, run_dir):
+        return None
+
+    def has_result(self, run_dir) -> bool:
+        return False
+
+    def run(self, prompt, ctx):
+        self.seen.append((prompt, ctx))
+        from evaluate.agents.base import AgentResult
+
+        return AgentResult(raw_output='{"category": "uncertain", "reasoning": "x"}')
+
+    def result_filename(self) -> str:
+        return "result.json"
+
+    def save_report(self, result_dir) -> None:
+        pass
+
+
+# ---------------------------------------------------------------------------
+# Flag surface
+# ---------------------------------------------------------------------------
+
+
+def test_run_parser_accepts_file_flags(tmp_path):
+    case = _write_one_case(tmp_path / "one.jsonl", _one_case(tmp_path))
+    prompt = tmp_path / "prompt.txt"
+    prompt.write_text("body {cve_id}", encoding="utf-8")
+    cfg = _config(
+        [
+            "run",
+            "--benchmark-file",
+            str(case),
+            "--prompt-file",
+            str(prompt),
+            "--output-dir",
+            str(tmp_path / "out"),
+        ]
+    )
+    assert cfg.benchmark_file == case
+    assert cfg.prompt_file == prompt
+    assert cfg.benchmark_path == case
+    assert cfg.benchmark_dir.name == "one"
+
+
+def test_parse_and_metrics_do_not_accept_file_flags():
+    """The overrides are run-stage-only; downstream stages keep registry args."""
+    for subcommand, register in (
+        ("parse", parse_mod.register_parser),
+        ("metrics", metrics_mod.register_parser),
+    ):
+        parser = argparse.ArgumentParser()
+        subs = parser.add_subparsers(dest="evaluate_cmd", required=True)
+        register(subs)
+        with pytest.raises(SystemExit):
+            parser.parse_args([subcommand, "--benchmark-file", "x.jsonl"])
+
+
+# ---------------------------------------------------------------------------
+# Fail-closed validation
+# ---------------------------------------------------------------------------
+
+
+def test_missing_benchmark_file_fails_closed(tmp_path):
+    with pytest.raises(ValidationError):
+        _config(
+            [
+                "run",
+                "--benchmark-file",
+                str(tmp_path / "nope.jsonl"),
+                "--output-dir",
+                str(tmp_path / "out"),
+            ]
+        )
+
+
+def test_missing_prompt_file_fails_closed(tmp_path):
+    with pytest.raises(ValidationError):
+        _config(
+            [
+                "run",
+                "--prompt-file",
+                str(tmp_path / "nope.txt"),
+                "--output-dir",
+                str(tmp_path / "out"),
+            ]
+        )
+
+
+def test_directory_is_not_a_benchmark_file(tmp_path):
+    with pytest.raises(ValidationError):
+        _config(["run", "--benchmark-file", str(tmp_path), "--output-dir",
+                 str(tmp_path / "out")])
+
+
+# ---------------------------------------------------------------------------
+# Rendering + snapshot_path
+# ---------------------------------------------------------------------------
+
+
+def test_file_run_renders_all_four_placeholders_and_snapshot_path(tmp_path):
+    snapshot = tmp_path / "snap"
+    snapshot.mkdir()
+    task = _one_case(snapshot)
+    case = _write_one_case(tmp_path / "one.jsonl", task)
+    prompt = tmp_path / "prompt.txt"
+    prompt.write_text(
+        "T={task_id} C={cve_id} R={repo_url} H={commit_sha} "
+        "S={snapshot_path} END",
+        encoding="utf-8",
+    )
+    cfg = _config(
+        [
+            "run",
+            "--model",
+            "m1",
+            "--agent",
+            "opencode",
+            "--benchmark-file",
+            str(case),
+            "--prompt-file",
+            str(prompt),
+            "--output-dir",
+            str(tmp_path / "out"),
+        ]
+    )
+
+    fake = _FakeAgent()
+    runmod._run_one(task, 1, config=cfg, agent=fake)
+
+    assert len(fake.seen) == 1
+    rendered, ctx = fake.seen[0]
+    # All four identity placeholders rendered from the task.
+    assert task["task_id"] in rendered
+    assert task["cve_id"] in rendered
+    assert task["repo_url"] in rendered
+    assert task["commit_sha"] in rendered
+    # snapshot_path is controller-only: value never reaches the prompt and
+    # the literal marker is left un-substituted.
+    assert str(snapshot) not in rendered
+    assert "{snapshot_path}" in rendered
+    # ...but it does select the source tree.
+    assert ctx.cwd == snapshot.resolve()
+
+    result = cfg.run_dir / task["task_id"] / "run_001" / "result.json"
+    assert result.exists()
+    # run_dir nests under the file-based prompt hash.
+    expected = (
+        tmp_path
+        / "out"
+        / cfg.prompt_hash
+        / "opencode"
+        / "m1"
+        / task["task_id"]
+        / "run_001"
+        / "result.json"
+    )
+    assert result == expected
+
+
+def test_registry_task_without_snapshot_path_uses_owner_repo(tmp_path, monkeypatch):
+    """Registry-style tasks keep the repos/<owner>/<repo>/<sha> layout."""
+    owner_repo = tmp_path / "repos" / "octo" / "widget" / "abc123"
+    owner_repo.mkdir(parents=True)
+    task = {
+        "task_id": "t1",
+        "cve_id": "CVE-1",
+        "repo_url": "https://github.com/octo/widget",
+        "commit_sha": "abc123",
+        "metadata": {"language": "go"},
+    }
+    cfg = _config(
+        [
+            "run",
+            "--agent",
+            "opencode",
+            "--repos-dir",
+            str(tmp_path / "repos"),
+            "--output-dir",
+            str(tmp_path / "out"),
+        ]
+    )
+    fake = _FakeAgent()
+    runmod._run_one(task, 1, config=cfg, agent=fake)
+    _, ctx = fake.seen[0]
+    assert ctx.cwd == owner_repo
+
+
+def test_snapshot_path_bypasses_owner_repo_layout(tmp_path):
+    """A non-GitHub repo_url must not break resolution when snapshot_path is set."""
+    snapshot = tmp_path / "snap"
+    snapshot.mkdir()
+    task = _one_case(snapshot)
+    task["repo_url"] = "not-a-url"  # parse_owner_repo would raise on this
+    cfg = _config(
+        [
+            "run",
+            "--agent",
+            "opencode",
+            "--output-dir",
+            str(tmp_path / "out"),
+        ]
+    )
+    fake = _FakeAgent()
+    runmod._run_one(task, 1, config=cfg, agent=fake)
+    _, ctx = fake.seen[0]
+    assert ctx.cwd == snapshot.resolve()
+
+
+def test_registry_benchmark_and_prompt_still_load():
+    """Named registry entries are untouched when no file overrides are given."""
+    cfg = _config(
+        [
+            "run",
+            "--agent",
+            "opencode",
+            "--benchmark",
+            "agent7_a2_smoke",
+            "--prompt",
+            "b1",
+        ]
+    )
+    tasks = load_tasks(cfg)
+    assert len(tasks) >= 1
+    assert cfg.benchmark_path.name == "agent7_a2_smoke.jsonl"
+    assert cfg.prompt_source == "b1"
+    assert "{cve_id}" in cfg.prompt_text
+
+
+# ---------------------------------------------------------------------------
+# Gate ordering: E6 gate fires before tasks are even loaded.
+# ---------------------------------------------------------------------------
+
+
+def test_e6_gate_closes_before_task_load(tmp_path, monkeypatch):
+    """Gated agent + no preflight report -> SystemExit before any run attempt."""
+    case = _write_one_case(tmp_path / "one.jsonl", _one_case(tmp_path))
+    cfg = ExperimentConfig(
+        model="qwen3.6-35b",
+        agent="opencode-b1p",
+        benchmark="vex_bench",
+        prompt="b1",
+        benchmark_file=case,
+        output_dir=tmp_path / "empty-out",
+    )
+
+    called = {"run_one": False}
+
+    def _spy(task, rep, *, config, agent):
+        called["run_one"] = True
+
+    monkeypatch.setattr(runmod, "_run_one", _spy)
+    with pytest.raises(SystemExit):
+        runmod.run(cfg)
+    assert called["run_one"] is False
