+"""E6 run-gate (fail-closed) and report schema tests."""
+
+import json
+import sys
+import time
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+from evaluate import e6 as e6mod  # noqa: E402
+
+
+def _report(status="PASS", **kw):
+    rep = {
+        "schema": e6mod.SCHEMA,
+        "status": status,
+        "image": {"id": "sha256:img", "tag": "t", "arch": "linux/arm64"},
+        "provider": {"status": "ok", "pinned_ips": ["10.0.0.1"],
+                     "host": "<corporate-provider-host>", "port": 443},
+        "config": {"sha256": "cfg"},
+        "report_redaction": {"api_key_present": False},
+        "checks": [{"id": "x", "status": "PASS"}],
+    }
+    rep.update(kw)
+    return rep
+
+
+def _write_report(root: Path, rep: dict) -> Path:
+    d = root / "e6"
+    d.mkdir(parents=True)
+    p = d / "security-boundary-check.json"
+    p.write_text(json.dumps(rep))
+    return p
+
+
+def test_gate_missing_report(tmp_path):
+    reasons = e6mod.check_e6_gate(model="qwen3.6-35b", output_dir=tmp_path)
+    assert reasons and "no E6 preflight report" in reasons[0]
+
+
+def test_gate_fail_status(tmp_path, monkeypatch):
+    _write_report(tmp_path, _report(status="FAIL"))
+    monkeypatch.setattr(
+        e6mod, "_image_facts",
+        lambda tag: {"tag": tag, "id": "sha256:img", "arch": "arm64"},
+    )
+    monkeypatch.setattr(
+        e6mod.e6, "config_sha256", lambda cfg: "cfg",
+    )
+    monkeypatch.setattr(
+        e6mod.e6, "synthesize_e6_config", lambda m: {},
+    )
+    reasons = e6mod.check_e6_gate(model="qwen3.6-35b", output_dir=tmp_path)
+    assert any("!= PASS" in r for r in reasons)
+
+
+def test_gate_pass_report_opens(tmp_path, monkeypatch):
+    _write_report(tmp_path, _report())
+    monkeypatch.setattr(
+        e6mod, "_image_facts",
+        lambda tag: {"tag": tag, "id": "sha256:img", "arch": "arm64"},
+    )
+    monkeypatch.setattr(e6mod.e6, "synthesize_e6_config", lambda m: {"x": 1})
+    monkeypatch.setattr(e6mod.e6, "config_sha256", lambda cfg: "cfg")
+    reasons = e6mod.check_e6_gate(model="qwen3.6-35b", output_dir=tmp_path)
+    assert reasons == []
+
+
+def test_gate_stale_report(tmp_path, monkeypatch):
+    p = _write_report(tmp_path, _report())
+    old = time.time() - 48 * 3600
+    import os
+
+    os.utime(p, (old, old))
+    monkeypatch.setattr(
+        e6mod, "_image_facts",
+        lambda tag: {"tag": tag, "id": "sha256:img", "arch": "arm64"},
+    )
+    monkeypatch.setattr(e6mod.e6, "synthesize_e6_config", lambda m: {})
+    monkeypatch.setattr(e6mod.e6, "config_sha256", lambda cfg: "cfg")
+    reasons = e6mod.check_e6_gate(model="qwen3.6-35b", output_dir=tmp_path)
+    assert any("stale" in r for r in reasons)
+
+
+def test_gate_image_drift(tmp_path, monkeypatch):
+    _write_report(tmp_path, _report())
+    monkeypatch.setattr(
+        e6mod, "_image_facts",
+        lambda tag: {"tag": tag, "id": "sha256:NEW", "arch": "arm64"},
+    )
+    monkeypatch.setattr(e6mod.e6, "synthesize_e6_config", lambda m: {})
+    monkeypatch.setattr(e6mod.e6, "config_sha256", lambda cfg: "cfg")
+    reasons = e6mod.check_e6_gate(model="qwen3.6-35b", output_dir=tmp_path)
+    assert any("image" in r for r in reasons)
+
+
+def test_gate_provider_unreachable_fails(tmp_path, monkeypatch):
+    rep = _report(status="FAIL")
+    rep["provider"]["status"] = "unreachable_infra"
+    _write_report(tmp_path, rep)
+    monkeypatch.setattr(
+        e6mod, "_image_facts",
+        lambda tag: {"tag": tag, "id": "sha256:img", "arch": "arm64"},
+    )
+    monkeypatch.setattr(e6mod.e6, "synthesize_e6_config", lambda m: {})
+    monkeypatch.setattr(e6mod.e6, "config_sha256", lambda cfg: "cfg")
+    reasons = e6mod.check_e6_gate(model="qwen3.6-35b", output_dir=tmp_path)
+    assert any("provider" in r for r in reasons)
+    assert any("!= PASS" in r for r in reasons)
+
+
+def test_gate_inconclusive_fails(tmp_path, monkeypatch):
+    rep = _report()
+    rep["checks"].append({"id": "live_negative_denials", "status": "INCONCLUSIVE"})
+    _write_report(tmp_path, rep)
+    monkeypatch.setattr(
+        e6mod, "_image_facts",
+        lambda tag: {"tag": tag, "id": "sha256:img", "arch": "arm64"},
+    )
+    monkeypatch.setattr(e6mod.e6, "synthesize_e6_config", lambda m: {})
+    monkeypatch.setattr(e6mod.e6, "config_sha256", lambda cfg: "cfg")
+    reasons = e6mod.check_e6_gate(model="qwen3.6-35b", output_dir=tmp_path)
+    assert any("inconclusive" in r.lower() for r in reasons)
+
+
+def test_run_gated_agents():
+    sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+    from evaluate import run as runmod
+
+    assert "opencode-b1p" in runmod.E6_GATED_AGENTS
+    assert "opencode-c1" not in runmod.E6_GATED_AGENTS
+    assert "codex" not in runmod.E6_GATED_AGENTS
