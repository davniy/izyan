+"""E6 config synthesis + sandbox argv tests (no docker required)."""
+
+import json
+import os
+import sys
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+from evaluate import e6_sandbox as e6  # noqa: E402
+
+MODEL = "custom-openai/Qwen/Qwen3.6-35B-A3B"
+
+
+def test_permission_object_exact():
+    cfg = e6.synthesize_e6_config(MODEL)
+    assert cfg["permission"] == {
+        "*": "deny",
+        "read": "allow",
+        "glob": "allow",
+        "grep": "allow",
+        "edit": "deny",
+        "bash": "deny",
+        "webfetch": "deny",
+        "websearch": "deny",
+        "task": "deny",
+        "skill": "deny",
+        "lsp": "deny",
+        "todowrite": "deny",
+        "question": "deny",
+        "external_directory": "deny",
+        "repo_clone": "deny",
+        "repo_overview": "deny",
+    }
+    # catch-all must come first so the v1 last-match rule resolves allows
+    assert list(cfg["permission"].keys())[0] == "*"
+
+
+def test_no_secret_and_no_mcp():
+    cfg = e6.synthesize_e6_config(MODEL)
+    blob = json.dumps(cfg)
+    assert "{env:" not in blob
+    assert "OPENAI_API_KEY" not in blob
+    assert "mcp" not in cfg
+    opts = cfg["provider"]["custom-openai"]["options"]
+    assert opts["apiKey"] == "e6-forwarder"
+    assert opts["baseURL"] == "http://127.0.0.1:18080/openai/v1/"
+
+
+def test_model_key_pinned():
+    cfg = e6.synthesize_e6_config(MODEL)
+    models = cfg["provider"]["custom-openai"]["models"]
+    assert "Qwen/Qwen3.6-35B-A3B" in models
+    assert models["Qwen/Qwen3.6-35B-A3B"]["limit"]["context"] == 262144
+
+
+def test_non_custom_openai_rejected():
+    with pytest.raises(e6.E6PolicyError):
+        e6.synthesize_e6_config("azure-cognitive-services/gpt-5.5")
+
+
+def test_create_argv_policy():
+    argv = e6.build_create_argv(
+        "vex-bench-go-opencode-e6:latest",
+        snapshot=Path("/tmp/snap"),
+        run_input=Path("/tmp/in"),
+        sock_path=Path("/tmp/p.sock"),
+        script="true",
+    )
+    s = " ".join(argv)
+    for flag in (
+        "--network none",
+        "--user 10001:10001",
+        "--read-only",
+        "--cap-drop ALL",
+        "--security-opt no-new-privileges:true",
+        "--pids-limit 256",
+        "--memory 4g",
+        "--memory-swap 4g",
+    ):
+        assert flag in s, flag
+    assert "--env-file" not in argv
+    assert "custom-openai" not in s
+    assert argv[-3:] == ["sh", "-lc", "true"]
+    assert argv[argv.index("--entrypoint") + 1] == e6.E6_GUARD
+    # binds are read-only
+    for pair in zip(argv, argv[1:]):
+        if pair[0] == "-v":
+            assert pair[1].endswith(":ro"), pair[1]
+    env_args = [a.split("=", 1) for a in argv if a.split("=")[0] in e6.E6_ENV]
+    env = dict(env_args)
+    assert env["HTTP_PROXY"] == ""
+    assert env["HTTPS_PROXY"] == ""
+    assert env["ALL_PROXY"] == ""
+    assert env["NO_PROXY"] == "127.0.0.1,localhost"
+    assert env["HOME"] == "/tmp"
+
+
+def test_attempt_script_no_skip_permissions():
+    script = e6.build_attempt_script(model=MODEL, timeout=60)
+    assert "--dangerously-skip-permissions" not in script
+    assert "e6-relay" in script
+    assert "opencode run" in script
+
+
+def test_validate_snapshot_flags(tmp_path):
+    """Three-way hygiene (2026-10-11, VerifyContained semantics): host
+    rejects escaping symlinks, non-regular nodes, setuid/setgid; inside-
+    root dangling links are inert + recorded; plain exec bits accepted
+    (Landlock e6-exec-guard denies their execution at runtime)."""
+    snap = tmp_path / "snap"
+    snap.mkdir()
+    (snap / "ok.go").write_text("package x\n")
+    # exec-bit regular file: accepted by the host check
+    exe = snap / "build.sh"
+    exe.write_text("#!/bin/sh\n")
+    exe.chmod(0o755)
+    assert e6.validate_snapshot(snap) == []
+    # inside-root dangling symlink: inert, recorded, not rejected
+    (snap / "dead").symlink_to("no-such-target")
+    dangling: list = []
+    assert e6.validate_snapshot(snap, dangling=dangling) == []
+    assert len(dangling) == 1 and "dead" in dangling[0]
+    # escaping symlink (resolves outside root)
+    (snap / "link").symlink_to("/etc/passwd")
+    # escaping dangling symlink (resolves outside AND unresolvable)
+    (snap / "esc-dead").symlink_to("/non/existing/file")
+    # non-regular node + setuid regular file
+    os.mkfifo(snap / "pipe")
+    suid = snap / "suid-bin"
+    suid.write_text("x\n")
+    suid.chmod(0o4755)
+    v = e6.validate_snapshot(snap)
+    assert any("escaping symlink" in x and "link" in x for x in v)
+    assert any("escaping symlink" in x and "esc-dead" in x for x in v)
+    assert any("non-regular" in x and "pipe" in x for x in v)
+    assert any("setuid/setgid" in x and "suid-bin" in x for x in v)
+    assert len(v) == 4
+    # inside-resolving symlink is fine; removing rejects leaves a clean tree
+    (snap / "link").unlink()
+    (snap / "esc-dead").unlink()
+    (snap / "pipe").unlink()
+    suid.chmod(0o755)
+    (snap / "link").symlink_to("ok.go")
+    assert e6.validate_snapshot(snap) == []
