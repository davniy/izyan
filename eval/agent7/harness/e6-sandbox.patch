+def test_sse_done_terminates_held_open_stream(scripted_forwarder):
+    """Provider sends data: [DONE] then holds the stream open (real OpenAI-compatible gateway
+    behaviour) — the forwarder must synthesize the zero-chunk and close."""
+    released = threading.Event()
+
+    def script(srv):
+        try:
+            while b"\r\n\r\n" not in srv.recv(65536):
+                pass
+            srv.sendall(b"HTTP/1.1 200 OK\r\ncontent-type: text/event-stream\r\n"
+                        b"transfer-encoding: chunked\r\n\r\n")
+            piece = b"data: {\"x\":1}\n\n"
+            srv.sendall(f"{len(piece):x}\r\n".encode() + piece + b"\r\n")
+            piece = b"data: [DONE]\n\n"
+            srv.sendall(f"{len(piece):x}\r\n".encode() + piece + b"\r\n")
+            # upstream holds the stream open — exactly the production bug
+            time.sleep(3)
+        except OSError:
+            pass
+        finally:
+            released.set()
+            srv.close()
+
+    f = scripted_forwarder(script)
+    s = socket.socket(socket.AF_UNIX)
+    s.settimeout(15)
+    s.connect(str(f.sock_path))
+    s.sendall(b"POST /openai/v1/chat/completions HTTP/1.1\r\n"
+              b"Host: <corporate-provider-host>\r\nContent-Length: 0\r\n\r\n")
+    data = b""
+    while True:
+        try:
+            c = s.recv(65536)
+        except socket.timeout:
+            break
+        if not c:
+            break
+        data += c
+    s.close()
+    f.stop()
+    assert b"[DONE]" in data
+    assert data.endswith(b"0\r\n\r\n")
