@@ -0,0 +1,80 @@
+#!/usr/bin/env bash
+# Build the E6 sandbox image for the A2 B1/R0 arms.
+#
+#   ./build-e6.sh
+#
+# Cross-compiles the three static E6 helpers (e6-relay, e6-exec-guard,
+# e6-probe) plus the e6-exec-test fixture binary (host-side only — the
+# preflight stages it inside the synthetic /work snapshot), then builds
+# vex-bench-go-opencode-e6:latest on the PINNED corp base image. Writes
+# e6-image.stamp with the real image id and helper hashes — these are
+# the pins the E6 report and run gate consume; never guessed.
+set -euo pipefail
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+
+# The E6 image MUST derive from the pinned corp base — check the id, not
+# just the tag (a retagged image would silently change the base).
+BASE_TAG="vex-bench-go-opencode-gw:latest"
+BASE_ID="sha256:91629799d07a08fc56e36fe1d51589cf3a1f24ff73ed9e09bad0331161703c13"
+actual_base="$(docker image inspect "$BASE_TAG" --format '{{.Id}}')"
+if [[ "$actual_base" != "$BASE_ID" ]]; then
+    echo "error: $BASE_TAG is $actual_base, expected $BASE_ID" >&2
+    exit 1
+fi
+
+GOARCH="$(docker info --format '{{.Architecture}}')"
+# docker reports "aarch64" where Go wants "arm64"
+GOARCH="${GOARCH/aarch64/arm64}"
+mkdir -p "$HERE/bin"
+
+echo ">>> building E6 helpers (linux/$GOARCH, static)"
+for d in e6-relay e6-exec-guard e6-probe e6-exec-test; do
+    (cd "$HERE/e6-helpers" && GOOS=linux GOARCH="$GOARCH" CGO_ENABLED=0 \
+        go build -trimpath -ldflags='-s -w' -o "$HERE/bin/$d" "./cmd/$d")
+done
+
+# ripgrep: opencode 1.15.5 shells out to `rg` and otherwise tries to
+# DOWNLOAD it at runtime (impossible under --network none). Bake the
+# pinned upstream release in — no apt package exists in the corp image's
+# sources (verified 2026-10-11).
+RG_VER=15.1.0
+RG_ARCH="${GOARCH/arm64/aarch64}"
+if [[ ! -x "$HERE/bin/rg" ]]; then
+    echo ">>> fetching ripgrep $RG_VER (linux/$RG_ARCH, pinned)"
+    curl -fsSL -o "$HERE/bin/rg-$RG_VER.tar.gz" \
+        "https://github.com/BurntSushi/ripgrep/releases/download/$RG_VER/ripgrep-$RG_VER-$RG_ARCH-unknown-linux-gnu.tar.gz"
+    tar -xzf "$HERE/bin/rg-$RG_VER.tar.gz" -C "$HERE/bin" \
+        "ripgrep-$RG_VER-$RG_ARCH-unknown-linux-gnu/rg" \
+        --strip-components=1 2>/dev/null || \
+        tar -xzf "$HERE/bin/rg-$RG_VER.tar.gz" -C "$HERE/bin"
+    # tar layout puts rg at ripgrep-<ver>-<arch>-unknown-linux-gnu/rg
+    if [[ ! -x "$HERE/bin/rg" ]]; then
+        cp "$HERE/bin/ripgrep-$RG_VER-$RG_ARCH-unknown-linux-gnu/rg" "$HERE/bin/rg"
+    fi
+    chmod +x "$HERE/bin/rg"
+    rm -f "$HERE/bin/rg-$RG_VER.tar.gz"
+    rm -rf "$HERE/bin/ripgrep-$RG_VER-$RG_ARCH-unknown-linux-gnu"
+fi
+
+echo ">>> building vex-bench-go-opencode-e6"
+docker build -t "vex-bench-go-opencode-e6:latest" \
+    -f "$HERE/go.opencode-e6.Dockerfile" "$HERE/.."
+
+IMAGE_ID="$(docker image inspect vex-bench-go-opencode-e6:latest --format '{{.Id}}')"
+
+cat > "$HERE/e6-image.stamp" <<EOF
+image=vex-bench-go-opencode-e6:latest
+image_id=$IMAGE_ID
+base=$BASE_TAG
+base_id=$BASE_ID
+built_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
+e6_relay_sha256=$(shasum -a 256 "$HERE/bin/e6-relay" | awk '{print $1}')
+e6_exec_guard_sha256=$(shasum -a 256 "$HERE/bin/e6-exec-guard" | awk '{print $1}')
+e6_probe_sha256=$(shasum -a 256 "$HERE/bin/e6-probe" | awk '{print $1}')
+e6_exec_test_sha256=$(shasum -a 256 "$HERE/bin/e6-exec-test" | awk '{print $1}')
+helpers_src_sha256=$(cd "$HERE/e6-helpers" && cat go.mod cmd/e6-relay/main.go cmd/e6-exec-guard/main.go cmd/e6-probe/main.go cmd/e6-exec-test/main.go | shasum -a 256 | awk '{print $1}')
+EOF
+
+echo ">>> done; image_id=$IMAGE_ID"
+echo ">>> stamp written to $HERE/e6-image.stamp"
diff --git a/docker/e6-helpers/cmd/e6-exec-guard/main.go b/docker/e6-helpers/cmd/e6-exec-guard/main.go
new file mode 100644
index 0000000..36b0310
--- /dev/null
+++ b/docker/e6-helpers/cmd/e6-exec-guard/main.go
@@ -0,0 +1,189 @@
+// e6-exec-guard: one-purpose Landlock EXECUTE guard for the E6 sandbox.
+//
+// Usage: e6-exec-guard <program> [args...]
+//
+// Installs a Landlock ruleset that handles LANDLOCK_ACCESS_FS_EXECUTE and
+// allows execution only beneath image system paths (/bin, /sbin, /lib*,
+// /usr — resolved through symlinks, so usrmerged layouts are covered).
+// Execution from /work, /tmp, /run-output, /run-input or any other path is
+// denied by the kernel with EACCES. The policy is inherited by all children
+// of the exec'd program, so it constrains opencode and everything it spawns.
+//
+// Fail-closed by construction: if Landlock is unavailable, the ABI cannot
+// handle EXECUTE, a rule cannot be added, or restriction fails, the guard
+// exits nonzero BEFORE the wrapped program runs. There is no degrade mode.
+package main
+
+import (
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"syscall"
+	"unsafe"
+)
+
+// Linux Landlock interface (asm-generic syscall numbers, identical on
+// arm64/amd64). Defined locally so the helper builds with the stdlib only.
+const (
+	sysLandlockCreateRuleset = 444
+	sysLandlockAddRule       = 445
+	sysLandlockRestrictSelf  = 446
+
+	landlockCreateRulesetVersion = 1 << 0
+
+	landlockRulePathBeneath = 1
+
+	landlockAccessFSExecute = 1 << 0
+)
+
+// allowedExecRoots are the only directory trees an execve() target may live
+// under. Nonexistent entries are skipped; symlinks are resolved by open(2)
+// following them, so merged-/usr layouts need no special casing.
+var allowedExecRoots = []string{
+	"/bin",
+	"/sbin",
+	"/lib",
+	"/lib32",
+	"/lib64",
+	"/libx32",
+	"/usr",
+}
+
+type landlockRulesetAttr struct {
+	HandledAccessFS uint64
+}
+
+type landlockPathBeneathAttr struct {
+	AllowedAccess uint64
+	ParentFD      int32
+	_             int32 // pad to 16 bytes per kernel ABI
+}
+
+func landlockCreateRuleset(attr *landlockRulesetAttr, flags uint32) (int, error) {
+	// For the VERSION query attr must be NULL *and* size 0; a nonzero size
+	// with a NULL pointer is EINVAL.
+	size := uintptr(0)
+	if attr != nil {
+		size = unsafe.Sizeof(*attr)
+	}
+	r1, _, errno := syscall.Syscall(
+		sysLandlockCreateRuleset,
+		uintptr(unsafe.Pointer(attr)),
+		size,
+		uintptr(flags),
+	)
+	if errno != 0 {
+		return -1, errno
+	}
+	return int(r1), nil
+}
+
+func landlockAddRule(rulesetFD int, rule *landlockPathBeneathAttr) error {
+	_, _, errno := syscall.Syscall6(
+		sysLandlockAddRule,
+		uintptr(rulesetFD),
+		landlockRulePathBeneath,
+		uintptr(unsafe.Pointer(rule)),
+		0, 0, 0,
+	)
+	if errno != 0 {
+		return errno
+	}
+	return nil
+}
+
+func landlockRestrictSelf(rulesetFD int) error {
+	_, _, errno := syscall.Syscall(
+		sysLandlockRestrictSelf,
+		uintptr(rulesetFD),
+		0,
+		0,
+	)
+	if errno != 0 {
+		return errno
+	}
+	return nil
+}
+
+func die(format string, args ...any) {
+	fmt.Fprintf(os.Stderr, "e6-exec-guard: "+format+"\n", args...)
+	os.Exit(127)
+}
+
+func main() {
+	args := os.Args[1:]
+	if len(args) > 0 && args[0] == "--" {
+		args = args[1:]
+	}
+	if len(args) == 0 {
+		die("usage: e6-exec-guard <program> [args...]")
+	}
+
+	// 1. Kernel must speak Landlock at all.
+	abi, err := landlockCreateRuleset(nil, landlockCreateRulesetVersion)
+	if err != nil {
+		die("landlock unavailable (E6 requires it; failing closed): %v", err)
+	}
+	if abi < 1 {
+		die("landlock ABI %d too old for EXECUTE policy (need >=1); failing closed", abi)
+	}
+
+	// 2. Ruleset handling EXECUTE only. Read/write stay governed by mounts.
+	ruleset, err := landlockCreateRuleset(
+		&landlockRulesetAttr{HandledAccessFS: landlockAccessFSExecute}, 0)
+	if err != nil {
+		die("cannot create landlock ruleset: %v", err)
+	}
+	defer syscall.Close(ruleset)
+
+	// 3. Allow execution beneath each existing system root.
+	added := map[string]bool{}
+	for _, dir := range allowedExecRoots {
+		resolved, rerr := filepath.EvalSymlinks(dir)
+		if rerr != nil {
+			resolved = dir
+		}
+		if added[resolved] {
+			continue
+		}
+		fd, oerr := syscall.Open(dir, syscall.O_PATH|syscall.O_DIRECTORY|syscall.O_CLOEXEC, 0)
+		if oerr != nil {
+			if os.IsNotExist(oerr) {
+				continue
+			}
+			die("cannot open exec root %s: %v", dir, oerr)
+		}
+		rule := landlockPathBeneathAttr{
+			AllowedAccess: landlockAccessFSExecute,
+			ParentFD:      int32(fd),
+		}
+		err = landlockAddRule(ruleset, &rule)
+		syscall.Close(fd)
+		if err != nil {
+			die("cannot add exec rule for %s: %v", dir, err)
+		}
+		added[resolved] = true
+	}
+	if len(added) == 0 {
+		die("no exec roots exist; refusing to install a deny-all-exec policy")
+	}
+	// 4. Restrict this process (and all future children). no_new_privs is a
+	//    hard prerequisite for unprivileged Landlock.
+	if _, _, errno := syscall.Syscall(syscall.SYS_PRCTL,
+		syscall.PR_SET_NO_NEW_PRIVS, 1, 0); errno != 0 {
+		die("prctl(PR_SET_NO_NEW_PRIVS): %v", errno)
+	}
+	if err := landlockRestrictSelf(ruleset); err != nil {
+		die("landlock_restrict_self failed; failing closed: %v", err)
+	}
+
+	// 5. Exec the fixed controller command under the policy.
+	binary, lerr := exec.LookPath(args[0])
+	if lerr != nil {
+		die("program %q not found: %v", args[0], lerr)
+	}
+	if err := syscall.Exec(binary, args, os.Environ()); err != nil {
+		die("exec %s: %v", binary, err)
+	}
+}
