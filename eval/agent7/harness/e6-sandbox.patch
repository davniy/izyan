+    s.sendall(b"GET /openai/v1/models HTTP/1.1\r\nHost: <corporate-provider-host>\r\n\r\n")
+    data = b""
+    while True:
+        c = s.recv(65536)
+        if not c:
+            break
+        data += c
+    s.close()
+    f.stop()
+    assert released.is_set()
+    assert data.endswith(b"short")  # truncated body relayed, conn closed
