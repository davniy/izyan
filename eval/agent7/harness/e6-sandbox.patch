+func checkSnapshotWrite() (bool, string, string) {
+	var results []string
+	ok := true
+	expect := func(name string, err error) {
+		if err == nil {
+			ok = false
+			results = append(results, name+"=SUCCEEDED(VIOLATION)")
+			return
+		}
+		n := errName(err)
+		results = append(results, name+"="+n)
+		if !strings.Contains(n, "EROFS") && !strings.Contains(n, "EACCES") && !strings.Contains(n, "EPERM") {
+			ok = false
+		}
