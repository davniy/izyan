+              b"Host: <corporate-provider-host>\r\nContent-Length: 0\r\n\r\n")
+    data = b""
+    while b"0\r\nX-Trailer: done\r\n\r\n" not in data:
+        chunk = s.recv(65536)
+        assert chunk, "connection closed before terminating chunk"
+        data += chunk
+    s.close()
+    f.stop()
+    assert b"transfer-encoding: chunked" in data
+    assert b"5\r\nhello\r\n6\r\n world\r\n" in data
+    assert b"0\r\nX-Trailer: done\r\n\r\n" in data
