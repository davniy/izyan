+def test_sse_style_stream_ends(scripted_forwarder):
+    """A long-lived chunked SSE body with pauses still terminates."""
+    done = threading.Event()
+
+    def script(srv):
+        while b"\r\n\r\n" not in srv.recv(65536):
+            pass
+        srv.sendall(b"HTTP/1.1 200 OK\r\ncontent-type: text/event-stream\r\n"
+                    b"transfer-encoding: chunked\r\n\r\n")
+        for i in range(3):
+            piece = f"data: {{\"i\": {i}}}\n\n".encode()
+            srv.sendall(f"{len(piece):x}\r\n".encode() + piece + b"\r\n")
+            time.sleep(0.05)
+        piece = b"data: [DONE]\n\n"
+        srv.sendall(f"{len(piece):x}\r\n".encode() + piece + b"\r\n")
+        srv.sendall(b"0\r\n\r\n")
+        time.sleep(0.3)
+        srv.close()
+        done.set()
+
+    f = scripted_forwarder(script)
+    s = socket.socket(socket.AF_UNIX)
+    s.settimeout(15)
+    s.connect(str(f.sock_path))
+    s.sendall(b"POST /openai/v1/chat/completions HTTP/1.1\r\n"
+              b"Host: <corporate-provider-host>\r\nContent-Length: 0\r\n\r\n")
+    data = b""
+    while not data.endswith(b"0\r\n\r\n"):
+        c = s.recv(65536)
+        assert c, "connection closed before terminating chunk"
+        data += c
+    s.close()
+    f.stop()
+    assert data.count(b"data:") == 4
+    assert b"[DONE]" in data
+    assert done.wait(timeout=15)
+
