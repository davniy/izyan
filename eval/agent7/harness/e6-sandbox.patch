+COPY docker/bin/e6-relay /usr/local/bin/e6-relay
+COPY docker/bin/e6-exec-guard /usr/local/bin/e6-exec-guard
+COPY docker/bin/e6-probe /usr/local/bin/e6-probe
+# opencode 1.15.5's grep tool shells out to rg and would otherwise try to
+# download it at runtime — impossible under --network none.
+COPY docker/bin/rg /usr/local/bin/rg
