+// --------------------------------------------------------------------
+// Execution guard (Landlock + noexec tmpfs + read-only /work)
+// --------------------------------------------------------------------
+
+func tryExec(path string) error {
+	cmd := exec.Command(path)
+	var out bytes.Buffer
+	cmd.Stdout, cmd.Stderr = &out, &out
+	err := cmd.Run()
+	if err == nil {
+		return fmt.Errorf("EXECUTED rc=0 out=%q", truncate(out.String(), 120))
+	}
+	var ee *exec.Error
+	if errors.As(err, &ee) {
+		return ee.Err
+	}
+	var xe *exec.ExitError
+	if errors.As(err, &xe) {
+		return fmt.Errorf("EXECUTED rc=%d out=%q", xe.ExitCode(), truncate(out.String(), 120))
+	}
+	return err
+}
+
+func checkExecDeniedWork() (bool, string, string) {
+	target := workDir + "/e6-exec-test"
+	st, err := os.Stat(target)
+	if err != nil {
+		return false, "missing", "synthetic executable not staged: " + errName(err)
+	}
+	if st.Mode()&0o111 == 0 {
+		return false, "not-executable", "fixture lacks +x bit"
+	}
+	err = tryExec(target)
+	if err == nil || strings.HasPrefix(err.Error(), "EXECUTED") {
+		return false, "EXECUTED", "sandbox violation: /work executable ran"
+	}
+	name := errName(err)
+	return strings.Contains(name, "EACCES") || strings.Contains(name, "EPERM"), name,
+		"expected EACCES from landlock exec policy"
+}
+
+func checkExecDeniedTmpfs() (bool, string, string) {
+	// Drop a known-good system binary into the noexec tmpfs and try to run it.
+	src, err := os.Open("/bin/true")
+	if err != nil {
+		return false, "no-source", errName(err)
+	}
+	defer src.Close()
+	dst := runOutput + "/x"
+	w, err := os.OpenFile(dst, os.O_CREATE|os.O_WRONLY|os.O_TRUNC, 0o755)
+	if err != nil {
+		return false, "stage-failed", errName(err)
+	}
+	if _, err := io.Copy(w, src); err != nil {
+		w.Close()
+		return false, "stage-failed", errName(err)
+	}
+	w.Close()
+	execErr := tryExec(dst)
+	if execErr == nil || strings.HasPrefix(execErr.Error(), "EXECUTED") {
+		return false, "EXECUTED", "sandbox violation: tmpfs executable ran"
+	}
+	name := errName(execErr)
+	ok := strings.Contains(name, "EACCES") || strings.Contains(name, "EPERM")
+	return ok, name, "expected EACCES (noexec tmpfs and landlock)"
+}
