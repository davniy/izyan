+
+var secretNameRE = regexp.MustCompile(`(?i)(custom-openai|API.?KEY|TOKEN|SECRET|PASSWORD|CREDENTIAL|AUTH)`)
+
+func checkSecretExposure() (bool, string, string) {
+	var bad []string
+	// 1. No credential-looking env NAME; only expected env names allowed.
+	allowed := map[string]bool{
+		"PATH": true, "HOME": true, "HOSTNAME": true, "TERM": true,
+		"XDG_CONFIG_HOME": true, "HTTP_PROXY": true, "HTTPS_PROXY": true,
+		"ALL_PROXY": true, "NO_PROXY": true, "PWD": true, "SHLVL": true,
+		"OLDPWD": true, "_": true, "LC_ALL": true, "LANG": true,
+		// Fixed image-provided env from the pinned corp base — the same set
+		// the host-side inspect allowlist accepts.
+		"GOLANG_VERSION": true, "GOTOOLCHAIN": true, "GOPATH": true,
+		"NODE_EXTRA_CA_CERTS": true,
+	}
+	for _, kv := range os.Environ() {
+		name, _, _ := strings.Cut(kv, "=")
+		if secretNameRE.MatchString(name) {
+			bad = append(bad, "env:"+name)
+		}
+		if !allowed[name] {
+			bad = append(bad, "unexpected-env:"+name)
+		}
+	}
+	// 2. /proc/*/environ for every visible process: same scan.
+	ents, _ := filepath.Glob("/proc/[0-9]*/environ")
+	for _, e := range ents {
+		data, err := os.ReadFile(e)
+		if err != nil {
+			continue
+		}
+		for _, kv := range strings.Split(string(data), "\x00") {
+			name, _, _ := strings.Cut(kv, "=")
+			if secretNameRE.MatchString(name) && !strings.HasPrefix(name, "NO_PROXY") {
+				bad = append(bad, "proc-environ:"+e+":"+name)
+			}
+		}
+	}
+	// 3. Synthesized config: dummy key only, no {env:...} indirection.
+	cfg, err := os.ReadFile(runInput + "/.config/opencode/opencode.json")
+	if err != nil {
+		bad = append(bad, "config-unreadable")
+	} else {
+		s := string(cfg)
+		if strings.Contains(s, "{env:") {
+			bad = append(bad, "config-env-indirection")
+		}
+		if !strings.Contains(s, `"e6-forwarder"`) {
+			bad = append(bad, "config-missing-dummy-key")
+		}
+		if strings.Contains(s, `"mcp"`) {
+			bad = append(bad, "config-has-mcp")
+		}
+	}
+	// 4. Mounted input must not contain env files.
+	for _, p := range []string{runInput + "/opencode.env", runInput + "/.env", "/.env"} {
+		if _, err := os.Stat(p); err == nil {
+			bad = append(bad, "envfile:"+p)
+		}
+	}
+	return len(bad) == 0, strings.Join(bad, ","), "no key/env-file/indirection allowed"
+}
