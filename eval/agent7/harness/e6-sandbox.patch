@@ -0,0 +1,750 @@
+"""E6 per-attempt provider forwarder (design: e6-design.md §1).
+
+The ONLY egress path available to an E6 container: a freshly created Unix
+socket (mode 0600) bind-mounted read-only at ``/run/provider.sock``. This
+module is deliberately NOT a general proxy:
+
+- resolves ``<corporate-provider-host>`` on the HOST once at start, pins the resolved
+  address set, and connects only to those addresses on TCP/443 with TLS
+  SNI/certificate verification for ``<corporate-provider-host>``;
+- accepts only plain HTTP/1.1 requests on the socket — rejects CONNECT,
+  absolute-form proxy requests, foreign ``Host`` headers, malformed and
+  oversized requests;
+- allowlist is host + method + path: ``GET /openai/v1/models`` and
+  ``POST /openai/v1/chat/completions`` — everything else is a hard
+  rejection, never an implicit expansion;
+- discards the container's ``Authorization`` header and injects the
+  host-side ``OPENAI_API_KEY``. The key is never sent to the container,
+  never written to logs or reports;
+- logs are redacted: method, path and status only — never headers, bodies,
+  or the key;
+- ``stop()`` (and the ``finally`` paths of callers) unlinks the socket.
+
+Provider unreachability (DNS failure, TCP connect timeout/refusal, TLS
+failure — e.g. VPN outage) raises :class:`ProviderUnreachable`, which the
+preflight maps to ``provider.status == "unreachable_infra"`` — an
+environment precondition failure, distinct from an isolation violation.
+"""
+
+from __future__ import annotations
+
+import logging
+import os
+import socket
+import ssl
+import threading
+from pathlib import Path
+
+logger = logging.getLogger(__name__)
+
+PROVIDER_HOST = "<corporate-provider-host>"
+PROVIDER_PORT = 443
+PROVIDER_PATH_PREFIX = "/openai/v1/"
+
+# Fixed allowlist: (method, path) pairs — anything else is rejected.
+ALLOWED_REQUESTS = {
+    ("GET", "/openai/v1/models"),
+    ("POST", "/openai/v1/chat/completions"),
+}
+
+# Host headers a legitimate client may legitimately send: the pinned
+# provider name (probe) or the loopback relay address (opencode via the
+# synthesized baseURL). Anything else is a proxy attempt.
+ALLOWED_HOST_HEADERS = {
+    PROVIDER_HOST,
+    f"{PROVIDER_HOST}:{PROVIDER_PORT}",
+    "127.0.0.1",
+    "127.0.0.1:18080",
+    "localhost",
+    "localhost:18080",
+}
+
+MAX_HEADER_BYTES = 64 * 1024
+MAX_BODY_BYTES = 16 * 1024 * 1024
+CONNECT_TIMEOUT_S = 10.0
+RESPONSE_TIMEOUT_S = 300.0
+# Max gap with no upstream bytes during a response before the relay gives
+# up — long-lived SSE bodies still deliver periodic chunks; a dead or
+# wedged upstream must not hold the container open.
+UPSTREAM_STALL_S = 120.0
+
+# Headers that must never transit: hop-by-hop plus every credential carrier
+# a client could smuggle a key through. The forwarder owns Authorization.
+_DROP_HEADERS = {
+    "connection",
+    "keep-alive",
+    "proxy-authenticate",
+    "proxy-authorization",
+    "proxy-connection",
+    "te",
+    "trailer",
+    "transfer-encoding",
+    "upgrade",
+    "authorization",
+    "x-api-key",
+    "api-key",
+    "apikey",
+    "cookie",
+    "set-cookie",
+}
+
+
+class ProviderUnreachable(RuntimeError):
+    """Host-side DNS/connect/TLS to the provider failed.
+
+    This is an ENVIRONMENT precondition (VPN/network outage), not a sandbox
+    violation — kept as a distinct type so the report can label it
+    ``unreachable_infra`` while still failing closed.
+    """
+
+
+def load_openai_key(env_file: Path | None = None) -> str:
+    """Read OPENAI_API_KEY host-side: process env first, then the harness
+    env file (which is NEVER mounted into E6 containers)."""
+    key = os.environ.get("OPENAI_API_KEY")
+    if key:
+        return key
+    env_file = env_file or Path("env/opencode/opencode.env")
+    if env_file.exists():
+        for line in env_file.read_text(encoding="utf-8").splitlines():
+            line = line.strip()
+            if line.startswith("OPENAI_API_KEY="):
+                return line.split("=", 1)[1].strip()
+    raise RuntimeError(
+        "OPENAI_API_KEY not found in environment or env/opencode/opencode.env"
+    )
+
+
+def resolve_provider(host: str = PROVIDER_HOST, port: int = PROVIDER_PORT) -> list[str]:
+    """Resolve and pin the provider address set on the host."""
+    try:
+        infos = socket.getaddrinfo(host, port, 0, socket.SOCK_STREAM)
+    except OSError as exc:
+        raise ProviderUnreachable(
+            f"cannot resolve {host}: {exc}. Provider DNS failed on the host — "
+            "this is an environment/VPN precondition failure (unreachable_infra)."
+        ) from exc
+    ips = sorted({i[4][0] for i in infos})
+    if not ips:
+        raise ProviderUnreachable(
+            f"{host} resolved to an empty address set — unreachable_infra"
+        )
+    return ips
+
+
+def check_provider_tls(ip: str, host: str = PROVIDER_HOST, port: int = PROVIDER_PORT) -> None:
+    """Verify TCP+TLS to one pinned address; raise ProviderUnreachable on any
+    failure (connect refused/timeout, handshake error, cert mismatch)."""
+    try:
+        raw = socket.create_connection((ip, port), timeout=CONNECT_TIMEOUT_S)
+    except OSError as exc:
+        raise ProviderUnreachable(
+            f"cannot connect to {host} ({ip}:{port}): {exc} — "
+            "environment/VPN precondition failure (unreachable_infra)"
+        ) from exc
+    try:
+        ctx = ssl.create_default_context()
+        with ctx.wrap_socket(raw, server_hostname=host) as tls:
+            tls.version()  # force handshake completion
+    except (ssl.SSLError, OSError) as exc:
+        raise ProviderUnreachable(
+            f"TLS to {host} ({ip}:{port}) failed: {exc} — "
+            "certificate/SNI verification or network precondition failure "
+            "(unreachable_infra)"
+        ) from exc
+
+
+class _Rejected(Exception):
+    def __init__(self, reason: str, status: int = 403):
+        super().__init__(reason)
+        self.reason = reason
+        self.status = status
+
+
+def _read_request(
+    client: socket.socket,
+) -> tuple[str, str, str, list[tuple[str, str]], bytes] | None:
+    """Parse one HTTP/1.1 request. Returns (method, target, version, headers,
+    body) or None on clean close. Raises _Rejected on any violation."""
+    buf = b""
+    while b"\r\n\r\n" not in buf:
+        if len(buf) > MAX_HEADER_BYTES:
+            raise _Rejected("headers_too_large", status=431)
+        chunk = client.recv(65536)
+        if not chunk:
+            return None if not buf else _die("truncated_headers")
+        buf += chunk
+    head, _, rest = buf.partition(b"\r\n\r\n")
+    if len(head) > MAX_HEADER_BYTES:
+        raise _Rejected("headers_too_large", status=431)
+    try:
+        lines = head.decode("latin-1").split("\r\n")
+        parts = lines[0].split(" ")
+        if len(parts) != 3:
+            raise _Rejected("malformed_request_line")
+        method, target, version = parts
+    except _Rejected:
+        raise
+    except Exception as exc:
+        raise _Rejected("malformed_request") from exc
+
+    if not version.startswith("HTTP/1."):
+        raise _Rejected("bad_http_version")
+    if method == "CONNECT" or not method.isalpha() or not method.isupper():
+        raise _Rejected("connect_or_bad_method")
+    if target.startswith(("http://", "https://", "//")) or target == "*":
+        raise _Rejected("absolute_form_or_asterisk")
+    if not target.startswith("/"):
+        raise _Rejected("non_origin_target")
+
+    headers: list[tuple[str, str]] = []
+    content_length = 0
+    chunked = False
+    for line in lines[1:]:
+        if not line:
+            continue
+        name, sep, value = line.partition(":")
+        if not sep:
+            raise _Rejected("malformed_header")
+        lname = name.strip().lower()
+        value = value.strip()
+        headers.append((lname, value))
+        if lname == "content-length":
+            try:
+                content_length = int(value)
+            except ValueError:
+                raise _Rejected("bad_content_length")
+        elif lname == "transfer-encoding":
+            if value.lower() != "chunked":
+                raise _Rejected("unsupported_transfer_encoding")
+            chunked = True
+
+    if content_length > MAX_BODY_BYTES:
+        raise _Rejected("body_too_large", status=413)
+
+    # Expect: 100-continue — the client withholds the body until it sees an
+    # interim 100 (Node/undici does this for bodies > ~1 KiB). Without this
+    # we would block forever reading a body that never arrives (verified
+    # live-turn hang, 2026-10-11).
+    expect = next((v.lower() for n, v in headers if n == "expect"), "")
+    if expect == "100-continue":
+        try:
+            client.sendall(b"HTTP/1.1 100 Continue\r\n\r\n")
+        except OSError:
+            raise _Rejected("client_abort")
+    elif expect:
+        raise _Rejected("unsupported_expect", status=417)
+
+    body = rest
+    if chunked:
+        body = _dechunk(client, body)
+    elif len(body) < content_length:
+        body += _read_exact(client, content_length - len(body))
+    elif len(body) > content_length:
+        body = body[:content_length]
+    return method, target, version, headers, body
+
+
+def _die(reason: str):
+    raise _Rejected(reason)
+
+
+def _read_exact(client: socket.socket, n: int) -> bytes:
+    out = b""
+    while len(out) < n:
+        chunk = client.recv(min(65536, n - len(out)))
+        if not chunk:
+            raise _Rejected("truncated_body")
+        out += chunk
+    return out
+
+
+def _dechunk(client: socket.socket, buf: bytes) -> bytes:
+    """Read a chunked body (chunk sizes may span recv boundaries)."""
+    body = b""
+    while True:
+        while b"\r\n" not in buf:
+            chunk = client.recv(65536)
+            if not chunk:
+                raise _Rejected("truncated_chunk")
+            buf += chunk
+        line, _, buf = buf.partition(b"\r\n")
+        try:
+            size = int(line.split(b";")[0].strip(), 16)
+        except ValueError:
+            raise _Rejected("bad_chunk_size")
+        if size == 0:
+            # trailers until blank line
+            while b"\r\n\r\n" not in buf and not buf.startswith(b"\r\n"):
+                chunk = client.recv(65536)
+                if not chunk:
+                    break
+                buf += chunk
+                if len(buf) > MAX_HEADER_BYTES:
+                    raise _Rejected("trailers_too_large", status=431)
+            return body
+        if len(body) + size > MAX_BODY_BYTES:
+            raise _Rejected("body_too_large", status=413)
+        while len(buf) < size + 2:
+            chunk = client.recv(min(65536, size + 2 - len(buf)))
+            if not chunk:
+                raise _Rejected("truncated_chunk")
+            buf += chunk
+        body += buf[:size]
+        buf = buf[size + 2:]
+
+
+def _forward_request(
+    tls: socket.socket,
+    method: str,
+    target: str,
+    headers: list[tuple[str, str]],
+    body: bytes,
+    api_key: str,
+) -> None:
+    """Send the sanitized request upstream over verified TLS."""
+    out_headers = [f"{method} {target} HTTP/1.1"]
+    out_headers.append(f"Host: {PROVIDER_HOST}")
+    kept = [(n, v) for n, v in headers if n not in _DROP_HEADERS and n != "host"
+            and n != "content-length"]
+    for n, v in kept:
+        out_headers.append(f"{n}: {v}")
+    out_headers.append(f"Authorization: Bearer {api_key}")
+    out_headers.append(f"Content-Length: {len(body)}")
+    out_headers.append("Connection: keep-alive")
+    tls.sendall(("\r\n".join(out_headers) + "\r\n\r\n").encode("latin-1") + body)
+
+
+def _client_send(client: socket.socket, data: bytes) -> bool:
+    """Send to the client; False on abort/timeout (stop relaying, hang up)."""
+    if not data:
+        return True
+    try:
+        client.sendall(data)
+        return True
+    except OSError:
+        return False
+
+
+def _relay_response(tls: socket.socket, client: socket.socket) -> bool:
+    """Stream one HTTP response upstream->client; return keep-alive flag.
+
+    HTTP/1.1 framing handled end-to-end: interim 1xx responses are relayed
+    and skipped, bodies follow Content-Length / Transfer-Encoding: chunked
+    (terminating zero-chunk + trailers) / EOF, and `Connection: close`.
+    Upstream EOF before the declared end closes both directions; a client
+    abort stops the relay and drops the upstream connection (the paid POST
+    is never silently retried).
+    """
+    buf = b""
+    try:
+        while True:
+            while b"\r\n\r\n" not in buf:
+                if len(buf) > MAX_HEADER_BYTES:
+                    return False
+                chunk = _recv_or_abort(tls, client, 65536)
+                if not chunk:
+                    if buf:
+                        _client_send(client, buf)
+                    return False
+                buf += chunk
+            head, _, rest = buf.partition(b"\r\n\r\n")
+            status_line = head.decode("latin-1").split("\r\n", 1)[0]
+            if not _client_send(client, head + b"\r\n\r\n"):
+                return False
+            try:
+                status = int(status_line.split(" ", 2)[1])
+            except (IndexError, ValueError):
+                status = 0
+            if 100 <= status < 200:
+                # interim response (e.g. a 100 Continue): consume it and keep
+                # relaying — bytes of the real response may already be buffered.
+                buf = rest
+                continue
+            break
+
+        headers = {}
+        for line in head.decode("latin-1").split("\r\n")[1:]:
+            n, _, v = line.partition(":")
+            headers[n.strip().lower()] = v.strip()
+
+        close = "close" in headers.get("connection", "").lower()
+        # Responses that carry no body by definition (RFC 9110 §15): the
+        # status line is the whole response — the rest is the next response.
+        if status in (204, 304) or status < 200:
+            return not close
+        if headers.get("transfer-encoding") == "chunked":
+            # OpenAI-compatible gateway SSE: the server sends `data: [DONE]` then holds the
+            # chunked stream open indefinitely (verified live 2026-10-11:
+            # >240s idle after [DONE]) — the client's fetch never resolves
+            # and `opencode run` cannot exit. [DONE] is the API-contract
+            # terminator, so the relay ends the body there: forward the
+            # zero-chunk ourselves and drop the upstream connection.
+            sse = "text/event-stream" in headers.get("content-type", "")
+            done = _relay_chunked(tls, client, rest, sse_end=sse)
+            if done == "sse_done":
+                done = True
+                close = True
+        elif "content-length" in headers:
+            try:
+                n = int(headers["content-length"])
+            except ValueError:
+                n = 0
+            if rest:
+                if not _client_send(client, rest[:n]):
+                    return False
+                n -= len(rest[:n])
+            done = _relay_exact(tls, client, n)
+        else:
+            # no declared framing: body runs to upstream EOF
+            if rest and not _client_send(client, rest):
+                return False
+            done = _relay_to_eof(tls, client)
+            close = True
+        return done and not close
+    except (_ClientGone, _UpstreamStall):
+        # client abort/cancel or a wedged upstream: drop both directions
+        logger.info("e6-forwarder stream ended early (client abort/stall)")
+        return False
+
+def _recv_or_abort(src: socket.socket, dst: socket.socket, n: int) -> bytes:
+    """Recv upstream while watching the client for abort.
+
+    Long-lived streams (SSE) keep upstream silent between chunks: if the
+    CLIENT closes meanwhile (cancel/abort), a bare src.recv would wait the
+    full stall timeout — that is what made `opencode run` hang after the
+    model finished (2026-10-11). select() on both sockets: client readable
+    means the exchange is over for the client (EOF = close; pipelined
+    bytes = next request we cannot honour mid-stream anyway) -> _ClientGone.
+    """
+    import select as _select
+
+    while True:
+        ready, _, _ = _select.select([src, dst], [], [], UPSTREAM_STALL_S)
+        if not ready:
+            raise _UpstreamStall()
+        if dst in ready:
+            try:
+                peek = dst.recv(1, socket.MSG_PEEK)
+            except OSError:
+                peek = b""
+            raise _ClientGone(peek)
+        return src.recv(n)
+
+
+class _ClientGone(Exception):
+    pass
+
+
+class _UpstreamStall(Exception):
+    pass
+
+
+
+def _relay_exact(src: socket.socket, dst: socket.socket, n: int) -> bool:
+    left = n
+    while left > 0:
+        chunk = _recv_or_abort(src, dst, min(65536, left))
+        if not chunk:
+            return False
+        if not _client_send(dst, chunk):
+            return False
+        left -= len(chunk)
+    return True
+
+
+def _relay_to_eof(src: socket.socket, dst: socket.socket) -> bool:
+    while True:
+        chunk = _recv_or_abort(src, dst, 65536)
+        if not chunk:
+            return False
+        if not _client_send(dst, chunk):
+            return False
+
+
+def _relay_chunked(src: socket.socket, dst: socket.socket, buf: bytes,
+                   sse_end: bool = False):
+    """Relay chunked framing verbatim until the terminating chunk.
+
+    Chunks are forwarded as they complete (SSE bodies stream through), the
+    terminating zero-chunk plus any trailers are relayed, upstream EOF
+    mid-body or a client abort returns False and the connection is torn
+    down. With ``sse_end`` (text/event-stream), `data: [DONE]` is the
+    API-contract terminator: the relay appends the zero-chunk itself and
+    returns "sse_done" so the caller drops the still-open upstream —
+    required because the provider holds the stream open after [DONE].
+    """
+    while True:
+        while b"\r\n" not in buf:
+            chunk = _recv_or_abort(src, dst, 65536)
+            if not chunk:
+                _client_send(dst, buf)
+                return False
+            buf += chunk
+        line, _, rest = buf.partition(b"\r\n")
+        try:
+            size = int(line.split(b";")[0].strip(), 16)
+        except ValueError:
+            _client_send(dst, buf)
+            return False
+        need = len(line) + 2 + size + 2
+        while len(buf) < need:
+            chunk = _recv_or_abort(src, dst, min(65536, need - len(buf)))
+            if not chunk:
+                _client_send(dst, buf)
+                return False
+            buf += chunk
+        if not _client_send(dst, buf[:need]):
+            return False
+        if sse_end and size > 0 and b"data: [DONE]" in buf[:need]:
+            # SSE terminator forwarded; synthesize the end-of-body.
+            _client_send(dst, b"0\r\n\r\n")
+            return "sse_done"
+        buf = buf[need:]
+        if size == 0:
+            # relay trailers up to the blank line
+            while not buf.startswith(b"\r\n") and b"\r\n\r\n" not in buf:
+                chunk = _recv_or_abort(src, dst, 65536)
+                if not chunk:
+                    _client_send(dst, buf)
+                    return True
+                buf += chunk
+            if buf.startswith(b"\r\n"):
+                _client_send(dst, b"\r\n")
+            else:
+                idx = buf.index(b"\r\n\r\n") + 4
+                _client_send(dst, buf[:idx])
+            return True
+
+
+def _reject(client: socket.socket, r: _Rejected) -> None:
+    body = b""
+    resp = (
+        f"HTTP/1.1 {r.status} Rejected\r\n"
+        f"x-e6-reject: {r.reason}\r\n"
+        f"content-length: {len(body)}\r\n"
+        "connection: close\r\n\r\n"
+    ).encode("latin-1") + body
+    try:
+        client.sendall(resp)
+    except OSError:
+        pass
+
+
+class ProviderForwarder:
+    """Per-attempt Unix-socket provider forwarder. Context manager."""
+
+    def __init__(
+        self,
+        sock_path: Path,
+        *,
+        api_key: str | None = None,
+        host: str = PROVIDER_HOST,
+        port: int = PROVIDER_PORT,
+    ):
+        self.sock_path = Path(sock_path)
+        self.host = host
+        self.port = port
+        self.api_key = api_key if api_key is not None else load_openai_key()
+        self.pinned_ips: list[str] = []
+        self._listener: socket.socket | None = None
+        self._tls_ctx = ssl.create_default_context()
+        self._stop = threading.Event()
+        self._thread: threading.Thread | None = None
+        self._rr = 0
+        self._rr_lock = threading.Lock()
+        self.destinations: set[str] = set()
+        self.stats = {"accepted": 0, "forwarded": 0, "rejected": 0}
+
+    def start(self) -> "ProviderForwarder":
+        """Resolve+pin provider IPs, verify TLS, open the socket.
+
+        Host-side guarantee: the socket DIRECTORY is 0700 owned by the
+        controller — only the controller user can reach the socket file
+        (0600-equivalent). The file itself is 0666, not 0600: on macOS
+        virtiofs a bind-mounted socket is presented root-owned and
+        connect() as uid 10001 is EACCES on a 0600 file (verified
+        2026-10-11). The container is untrusted anyway — the allowlist,
+        not file permissions, is the security boundary."""
+        self.pinned_ips = resolve_provider(self.host, self.port)
+        check_provider_tls(self.pinned_ips[0], self.host, self.port)
+        self.sock_path.parent.mkdir(parents=True, exist_ok=True)
+        os.chmod(self.sock_path.parent, 0o700)
+        self.sock_path.unlink(missing_ok=True)
+        listener = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+        listener.bind(str(self.sock_path))
+        os.chmod(self.sock_path, 0o666)
+        listener.listen(16)
+        listener.settimeout(1.0)
+        self._listener = listener
+        self._thread = threading.Thread(
+            target=self._accept_loop, name="e6-forwarder", daemon=True
+        )
+        self._thread.start()
+        logger.info(
+            "e6-forwarder listening on %s; provider %s:%d pinned=%s",
+            self.sock_path, self.host, self.port, ",".join(self.pinned_ips),
+        )
+        return self
+
+    def stop(self) -> None:
+        self._stop.set()
+        if self._listener is not None:
+            try:
+                self._listener.close()
+            except OSError:
+                pass
+            self._listener = None
+        if self._thread is not None:
+            self._thread.join(timeout=5)
+            self._thread = None
+        self.sock_path.unlink(missing_ok=True)
+
+    def __enter__(self) -> "ProviderForwarder":
+        return self.start()
+
+    def __exit__(self, *exc) -> None:
+        self.stop()
+
+    def _next_ip(self) -> str:
+        with self._rr_lock:
+            ip = self.pinned_ips[self._rr % len(self.pinned_ips)]
+            self._rr += 1
+        return ip
+
+    def _accept_loop(self) -> None:
+        while not self._stop.is_set():
+            try:
+                client, _ = self._listener.accept()
+            except socket.timeout:
+                continue
+            except OSError:
+                break
+            self.stats["accepted"] += 1
+            threading.Thread(
+                target=self._serve_client, args=(client,), daemon=True
+            ).start()
+
+    def _connect_upstream(self) -> socket.socket:
+        ip = self._next_ip()
+        try:
+            raw = socket.create_connection((ip, self.port), timeout=CONNECT_TIMEOUT_S)
+        except OSError as exc:
+            raise ProviderUnreachable(
+                f"connect to {self.host} ({ip}:{self.port}) failed: {exc} — "
+                "environment/VPN precondition failure (unreachable_infra)"
+            ) from exc
+        try:
+            tls = self._tls_ctx.wrap_socket(raw, server_hostname=self.host)
+        except (ssl.SSLError, OSError) as exc:
+            raw.close()
+            raise ProviderUnreachable(
+                f"TLS to {self.host} ({ip}:{self.port}) failed: {exc} — "
+                "unreachable_infra"
+            ) from exc
+        tls.settimeout(RESPONSE_TIMEOUT_S)
+        with self._rr_lock:
+            self.destinations.add(f"{self.host}:{self.port} via {ip}")
+        return tls
+
+    def _serve_client(self, client: socket.socket) -> None:
+        try:
+            client.settimeout(RESPONSE_TIMEOUT_S)
+            upstream: socket.socket | None = None
+            try:
+                while True:
+                    try:
+                        req = _read_request(client)
+                    except _Rejected as r:
+                        self.stats["rejected"] += 1
+                        logger.info(
+                            "e6-forwarder REJECT %s (status=%d)", r.reason, r.status
+                        )
+                        _reject(client, r)
+                        return
+                    except (OSError, socket.timeout):
+                        return
+                    if req is None:
+                        return
+                    method, target, _version, headers, body = req
+                    try:
+                        self._validate(method, target, headers)
+                    except _Rejected as r:
+                        self.stats["rejected"] += 1
+                        logger.info(
+                            "e6-forwarder REJECT %s %s: %s", method, target, r.reason
+                        )
+                        _reject(client, r)
+                        return
+
+                    if upstream is None:
+                        upstream = self._connect_upstream()
+                    try:
+                        _forward_request(upstream, method, target, headers, body,
+                                         self.api_key)
+                    except ProviderUnreachable:
+                        raise
+                    except (OSError, socket.timeout):
+                        # Send failed before any response bytes: retry once on
+                        # a fresh upstream connection.
+                        try:
+                            upstream.close()
+                        except OSError:
+                            pass
+                        upstream = self._connect_upstream()
+                        _forward_request(upstream, method, target, headers, body,
+                                         self.api_key)
+                    # From here on the response may be streaming; a mid-
+                    # response failure surfaces as a dropped connection — never
+                    # silently retried (would duplicate a paid POST).
+                    try:
+                        keep = _relay_response(upstream, client)
+                    except (OSError, socket.timeout):
+                        # Client abort or upstream socket error mid-stream:
+                        # tear the whole connection down.
+                        return
+                    # Honour a client-requested Connection: close — the
+                    # upstream keep-alive is per-client-connection anyway.
+                    client_close = "close" in next(
+                        (v.lower() for n, v in headers if n == "connection"), ""
+                    )
+                    self.stats["forwarded"] += 1
+                    logger.info(
+                        "e6-forwarder %s %s -> %s:%d",
+                        method, target, self.host, self.port,
+                    )
+                    if not keep or client_close:
+                        return
+            finally:
+                if upstream is not None:
+                    try:
+                        upstream.close()
+                    except OSError:
+                        pass
+        except ProviderUnreachable as exc:
+            logger.error("e6-forwarder provider unreachable: %s", exc)
+            try:
+                client.sendall(
+                    b"HTTP/1.1 502 Bad Gateway\r\nx-e6-reject: provider_unreachable\r\n"
+                    b"content-length: 0\r\nconnection: close\r\n\r\n"
+                )
+            except OSError:
+                pass
+        except Exception:
+            logger.exception("e6-forwarder client handler crashed")
+        finally:
+            try:
+                client.close()
+            except OSError:
+                pass
+
+    def _validate(self, method: str, target: str, headers: list[tuple[str, str]]) -> None:
+        host_headers = [v for n, v in headers if n == "host"]
+        if len(host_headers) != 1 or host_headers[0].lower() not in ALLOWED_HOST_HEADERS:
+            raise _Rejected("foreign_host")
+        # strip query for the exact-path check; '..' never allowed anywhere
+        path = target.split("?", 1)[0]
+        if ".." in path or not path.startswith(PROVIDER_PATH_PREFIX):
+            raise _Rejected("path_not_allowed")
+        if (method, path) not in ALLOWED_REQUESTS:
+            raise _Rejected("method_or_path_not_allowed")
