+def test_client_abort_mid_body(scripted_forwarder):
+    """Client vanishing mid-stream stops the relay; no crash, no hang."""
+    finished = threading.Event()
+
+    def script(srv):
+        try:
+            while b"\r\n\r\n" not in srv.recv(65536):
+                pass
+            srv.sendall(b"HTTP/1.1 200 OK\r\ncontent-length: 1000000\r\n\r\n")
+            # keep producing; client will disconnect immediately
+            for _ in range(200):
+                srv.sendall(b"y" * 4096)
+                time.sleep(0.01)
+        except OSError:
+            pass
+        finally:
+            finished.set()
+            srv.close()
+
+    f = scripted_forwarder(script)
+    s = socket.socket(socket.AF_UNIX)
+    s.settimeout(15)
+    s.connect(str(f.sock_path))
+    s.sendall(b"POST /openai/v1/chat/completions HTTP/1.1\r\n"
+              b"Host: <corporate-provider-host>\r\nContent-Length: 0\r\n\r\n")
+    # read a little then abort
+    s.recv(8192)
+    s.close()
+    assert finished.wait(timeout=15)
+    f.stop()
