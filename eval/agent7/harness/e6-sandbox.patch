+"""E6 forwarder allowlist/rejection/redaction tests.
+
+Uses a loopback "upstream" — no real provider needed: the forwarder's
+validation runs before any upstream connection, and the allowlisted path
+is exercised against a stub TLS-less upstream by monkeypatching the
+connector.
+"""
+
+import json
+import socket
+import sys
+import threading
+import time
+from pathlib import Path
+
+import pytest
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+from evaluate import e6_forwarder as fwd  # noqa: E402
+
+
+def _unix_get(sock_path: Path, request: str) -> str:
+    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
+    s.settimeout(10)
+    s.connect(str(sock_path))
+    s.sendall(request.encode())
+    data = b""
+    try:
+        while True:
+            chunk = s.recv(65536)
+            if not chunk:
+                break
+            data += chunk
+            if b"\r\n\r\n" in data and b"content-length: 0" in data:
+                break
+    except socket.timeout:
+        pass
+    s.close()
+    return data.decode("latin-1", "replace")
+
+
+@pytest.fixture
+def sockdir():
+    """Short unix-socket dir: /var/folders paths exceed the 104-byte limit."""
+    import shutil
+    import tempfile
+
