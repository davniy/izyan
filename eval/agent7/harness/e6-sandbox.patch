+// --------------------------------------------------------------------
+// Network isolation
+// --------------------------------------------------------------------
+
+func checkInterfaces() (bool, string, string) {
+	ifs, err := net.Interfaces()
+	if err != nil {
+		return false, "enum-failed", errName(err)
+	}
+	var bad []string
+	var names []string
+	for _, i := range ifs {
+		names = append(names, i.Name)
+		addrs, _ := i.Addrs()
+		for _, a := range addrs {
+			ip, _, _ := net.ParseCIDR(a.String())
+			if ip != nil && !ip.IsLoopback() {
+				bad = append(bad, i.Name+"="+a.String())
+			}
+		}
+	}
+	return len(bad) == 0, strings.Join(names, ","), "non-loopback addrs: " + strings.Join(bad, ",")
+}
+
+func dialErrSummary(err error) string {
+	var oe *net.OpError
+	if errors.As(err, &oe) {
+		if oe.Err != nil {
+			return errName(oe.Err)
+		}
+	}
+	return errName(err)
+}
