+def test_upstream_eof_mid_body(scripted_forwarder):
+    """Upstream dying before Content-Length closes the client side too."""
+    released = threading.Event()
+
+    def script(srv):
+        while b"\r\n\r\n" not in srv.recv(65536):
+            pass
+        srv.sendall(b"HTTP/1.1 200 OK\r\ncontent-length: 100\r\n\r\nshort")
+        srv.close()
+        released.set()
+
+    f = scripted_forwarder(script)
+    s = socket.socket(socket.AF_UNIX)
+    s.settimeout(15)
