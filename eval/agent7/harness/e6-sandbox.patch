+def test_chunked_response_terminated(scripted_forwarder):
+    """Chunked body incl. zero-chunk and trailers relays fully."""
+
+    def script(srv):
+        while b"\r\n\r\n" not in srv.recv(65536):
+            pass
+        srv.sendall(
+            b"HTTP/1.1 200 OK\r\ncontent-type: application/json\r\n"
+            b"transfer-encoding: chunked\r\n\r\n"
+            b"5\r\nhello\r\n6\r\n world\r\n"
+            b"0\r\nX-Trailer: done\r\n\r\n"
+        )
+        time.sleep(0.5)
+        srv.close()
+
+    f = scripted_forwarder(script)
+    s = socket.socket(socket.AF_UNIX)
+    s.settimeout(15)
