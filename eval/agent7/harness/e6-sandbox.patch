@@ -0,0 +1,17 @@
+// e6-exec-test: synthetic product executable for the E6 probe.
+//
+// Placed into the synthetic /work snapshot by the host preflight. Under the
+// E6 policy, exec'ing it must fail with EACCES (Landlock EXECUTE denies
+// everything outside system paths) — if it ever runs, the sandbox is broken
+// and it says so on stdout before exiting nonzero.
+package main
+
+import (
+	"fmt"
+	"os"
+)
+
+func main() {
+	fmt.Println("e6-exec-test: EXECUTED — sandbox violation")
+	os.Exit(99)
+}
diff --git a/docker/e6-helpers/cmd/e6-probe/main.go b/docker/e6-helpers/cmd/e6-probe/main.go
new file mode 100644
index 0000000..694dca2
--- /dev/null
+++ b/docker/e6-helpers/cmd/e6-probe/main.go
@@ -0,0 +1,718 @@
+// e6-probe: fixed in-container negative/positive checks for the E6 sandbox.
+//
+// Runs INSIDE a real E6 container, under e6-exec-guard (so the Landlock
+// EXECUTE policy is already installed). Emits one JSON document on stdout:
+//
+//	{"probe": "e6-probe/1", "self_sha256": "...", "checks": [
+//	  {"id": "...", "where": "container_script", "expected": "...",
+//	   "observed": "...", "status": "PASS|FAIL", "detail": "..."}]}
+//
+// Every check is recorded — a crashed check is a FAIL entry, never a lost
+// one. The probe never prints environment values (names only) and never
+// receives or logs any credential.
+package main
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"regexp"
+	"strings"
+	"syscall"
+	"time"
+)
+
+const (
+	providerSock  = "/run/provider.sock"
+	relayBase     = "http://127.0.0.1:18080"
+	wantOpencodeV = "1.15.5"
+	workDir       = "/work"
+	runInput      = "/run-input"
+	runOutput     = "/run-output"
+)
+
+type check struct {
+	ID       string `json:"id"`
+	Where    string `json:"where"`
+	Expected string `json:"expected"`
+	Observed string `json:"observed"`
+	Status   string `json:"status"`
+	Detail   string `json:"detail,omitempty"`
+}
+
+type probeReport struct {
+	Probe      string  `json:"probe"`
+	SelfSHA256 string  `json:"self_sha256"`
+	Checks     []check `json:"checks"`
+}
+
+var checks []check
+
+func rec(id, expected string, ok bool, observed, detail string) {
+	status := "PASS"
+	if !ok {
+		status = "FAIL"
+	}
+	checks = append(checks, check{
+		ID:       id,
+		Where:    "container_script",
+		Expected: expected,
+		Observed: truncate(observed, 300),
+		Status:   status,
+		Detail:   truncate(detail, 300),
+	})
+}
+
+func truncate(s string, n int) string {
+	if len(s) <= n {
+		return s
+	}
+	return s[:n] + "…"
+}
+
+func guarded(id, expected string, fn func() (bool, string, string)) {
+	defer func() {
+		if r := recover(); r != nil {
+			rec(id, expected, false, "panic", fmt.Sprintf("%v", r))
+		}
+	}()
+	ok, observed, detail := fn()
+	rec(id, expected, ok, observed, detail)
+}
+
+func errName(err error) string {
+	if err == nil {
+		return "ok"
+	}
+	var pe *os.PathError
+	if errors.As(err, &pe) {
+		return fmt.Sprintf("%s(%s)", pe.Op, errnoName(pe.Err))
+	}
+	var le *os.LinkError
+	if errors.As(err, &le) {
+		return fmt.Sprintf("%s(%s)", le.Op, errnoName(le.Err))
+	}
+	var se *os.SyscallError
+	if errors.As(err, &se) {
+		return fmt.Sprintf("%s(%s)", se.Syscall, errnoName(se.Err))
+	}
+	return err.Error()
+}
+
+func errnoName(err error) string {
+	var en syscall.Errno
+	if errors.As(err, &en) {
+		switch en {
+		case syscall.ENOENT:
+			return "ENOENT"
+		case syscall.EACCES:
+			return "EACCES"
+		case syscall.EPERM:
+			return "EPERM"
+		case syscall.EROFS:
+			return "EROFS"
+		case syscall.ENETUNREACH:
+			return "ENETUNREACH"
+		case syscall.EADDRNOTAVAIL:
+			return "EADDRNOTAVAIL"
+		case syscall.ECONNREFUSED:
+			return "ECONNREFUSED"
+		case syscall.ETIMEDOUT:
+			return "ETIMEDOUT"
+		default:
+			return en.Error()
+		}
+	}
+	return err.Error()
+}
+
+// --------------------------------------------------------------------
+// Identity / mounts / policy posture
+// --------------------------------------------------------------------
+
+func checkRuntimeIdentity() (bool, string, string) {
+	uid, gid := os.Getuid(), os.Getgid()
+	home := os.Getenv("HOME")
+	ok := uid == 10001 && gid == 10001
+	return ok, fmt.Sprintf("uid=%d gid=%d home=%s", uid, gid, home),
+		"expected uid=10001 gid=10001"
+}
+
+type mountEntry struct {
+	source string
+	fstype string
+	opts   string
+}
+
+func parseMounts() map[string]mountEntry {
+	out := map[string]mountEntry{}
+	data, err := os.ReadFile("/proc/self/mounts")
+	if err != nil {
+		return out
+	}
+	for _, line := range strings.Split(string(data), "\n") {
+		f := strings.Fields(line)
+		if len(f) < 4 {
+			continue
+		}
+		out[f[1]] = mountEntry{source: f[0], fstype: f[2], opts: f[3]}
+	}
+	return out
+}
+
+func checkMountFlags() (bool, string, string) {
+	mounts := parseMounts()
+	want := map[string]struct{ fstype, opts string }{
+		"/work":              {"", "ro"},
+		"/run-input":         {"", "ro"},
+		"/run/provider.sock": {"", "ro"},
+		"/tmp":               {"tmpfs", "rw,nosuid,nodev,noexec"},
+		"/run-output":        {"tmpfs", "rw,nosuid,nodev,noexec"},
+		"/":                  {"", "ro"},
+	}
+	var bad []string
+	var seen []string
+	for target, w := range want {
+		m, ok := mounts[target]
+		if !ok {
+			bad = append(bad, target+":missing")
+			continue
+		}
+		seen = append(seen, fmt.Sprintf("%s=%s(%s)", target, m.fstype, m.opts))
+		if w.fstype != "" && m.fstype != w.fstype {
+			bad = append(bad, fmt.Sprintf("%s:fstype=%s", target, m.fstype))
+			continue
+		}
+		for _, o := range strings.Split(w.opts, ",") {
+			if !strings.Contains(m.opts, o) {
+				bad = append(bad, fmt.Sprintf("%s:missing_opt=%s", target, o))
+			}
+		}
+	}
+	return len(bad) == 0, strings.Join(seen, " | "), "mismatches: " + strings.Join(bad, ",")
+}
+
+func checkCapsPidsMemory() (bool, string, string) {
+	var bad []string
+	observed := map[string]string{}
+
+	if st, err := os.ReadFile("/proc/self/status"); err == nil {
+		for _, line := range strings.Split(string(st), "\n") {
+			if strings.HasPrefix(line, "CapEff:") {
+				observed["CapEff"] = strings.TrimSpace(strings.TrimPrefix(line, "CapEff:"))
+				if observed["CapEff"] != "0000000000000000" {
+					bad = append(bad, "CapEff="+observed["CapEff"])
+				}
+			}
+		}
+	} else {
+		bad = append(bad, "status unreadable")
+	}
+
+	pids, err := os.ReadFile("/sys/fs/cgroup/pids.max")
+	if err != nil {
+		pids, err = os.ReadFile("/sys/fs/cgroup/pids/pids.max")
+	}
+	if err == nil {
+		observed["pids.max"] = strings.TrimSpace(string(pids))
+		if observed["pids.max"] != "256" {
+			bad = append(bad, "pids.max="+observed["pids.max"])
+		}
+	} else {
+		observed["pids.max"] = "unreadable:" + errName(err)
+	}
+
+	mem, err := os.ReadFile("/sys/fs/cgroup/memory.max")
+	if err != nil {
+		mem, err = os.ReadFile("/sys/fs/cgroup/memory/memory.limit_in_bytes")
+	}
+	if err == nil {
+		observed["memory.max"] = strings.TrimSpace(string(mem))
+		if observed["memory.max"] != "4294967296" {
+			bad = append(bad, "memory.max="+observed["memory.max"])
+		}
+	} else {
+		observed["memory.max"] = "unreadable:" + errName(err)
+	}
+
+	swap, err := os.ReadFile("/sys/fs/cgroup/memory.swap.max")
+	if err != nil {
+		swap, err = os.ReadFile("/sys/fs/cgroup/memory/memory.memsw.limit_in_bytes")
+	}
+	// Informational: Docker Desktop's VM reports memory.swap.max=0 even
+	// when --memory-swap 4g is set (the enforceable pin is
+	// HostConfig.MemorySwap, already validated by inspect).
+	if err == nil {
+		observed["memory.swap.max"] = strings.TrimSpace(string(swap))
+	} else {
+		observed["memory.swap.max"] = "unreadable:" + errName(err)
+	}
+
+	b, _ := json.Marshal(observed)
+	return len(bad) == 0, string(b), "mismatches: " + strings.Join(bad, ",")
+}
