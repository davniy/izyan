+"""E6 sandbox policy — shared between the agent run path and the preflight.
+
+Single source of truth for the frozen E6 container policy (design:
+e6-design.md §1-§4): docker create flags, mounts, env, entrypoint guard,
+fixed scripts, snapshot validation, and inspect-before-start enforcement.
+
+Used by ``agents/opencode_c1.py`` (B1/R0 arm runs) and ``evaluate/e6.py``
+(preflight + run gate). A run whose container policy differs from the probe
+policy is impossible by construction — both call ``create_e6_container`` /
+``inspect_and_validate`` here.
+
+Fail-closed contract: every helper raises ``E6PolicyError`` on the first
+violation; nothing degrades to a warning.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import json
+import logging
+import os
+import shlex
+import shutil
+import stat
+import subprocess
+import threading
+import time
+from dataclasses import dataclass
+from pathlib import Path
+
+from evaluate.agents.base import _copy_container_artifacts, _write_io_logs
+
+logger = logging.getLogger(__name__)
+
+E6_IMAGE = "vex-bench-go-opencode-e6:latest"
+E6_USER = "10001:10001"
+E6_GUARD = "/usr/local/bin/e6-exec-guard"
+E6_RELAY = "/usr/local/bin/e6-relay"
+E6_PROBE = "/usr/local/bin/e6-probe"
+E6_PIDS_LIMIT = "256"
+E6_MEMORY = "4g"
+E6_TMPFS_TMP = "rw,nosuid,nodev,noexec,size=128m,uid=10001,gid=10001,mode=1777"
+E6_TMPFS_RUN_OUTPUT = "rw,nosuid,nodev,noexec,size=64m,uid=10001,gid=10001,mode=0700"
+
+CONTAINER_WORK = "/work"
+CONTAINER_RUN_INPUT = "/run-input"
+CONTAINER_RUN_OUTPUT = "/run-output"
+CONTAINER_SOCK = "/run/provider.sock"
+CONTAINER_PROMPT = "/run-input/prompt.txt"
+CONTAINER_CONFIG = "/run-input/.config/opencode/opencode.json"
+
+# Env written into the container: cleared proxies + scratch HOME + a
+# WRITABLE config home. opencode writes .gitignore/session state into its
+# config dir at startup, so /run-input (read-only) cannot be
+# XDG_CONFIG_HOME — the fixed script copies the synthesized file from
+# /run-input to /tmp/.config first (verified requirement 2026-10-11).
+E6_ENV = {
+    "HOME": "/tmp",
+    "XDG_CONFIG_HOME": "/tmp/.config",
+    "HTTP_PROXY": "",
+    "HTTPS_PROXY": "",
+    "ALL_PROXY": "",
+    "NO_PROXY": "127.0.0.1,localhost",
+}
+
+# Fixture filenames the SYNTHETIC probe snapshot intentionally contains and
+# that validate_snapshot must not flag there. A real A2 snapshot containing
+# them is still rejected (allow_probe_fixtures=False on the run path).
+PROBE_FIXTURE_NAMES = {"e6-exec-test", "e6-escape-link"}
+
+# Names that must never appear in container env (secret carriers).
+_FORBIDDEN_ENV_MARKERS = ("KEY", "TOKEN", "SECRET", "PASSWORD", "CREDENTIAL", "AUTH")
+_ALLOWED_ENV_NAMES = {
+    # Our explicit E6_ENV names plus the fixed image-provided env from the
+    # pinned corp base (PATH/GOLANG_*/GOPATH/NODE_EXTRA_CA_CERTS). Anything
+    # else — and anything credential-shaped — fails inspect-before-start.
+    "PATH", "HOSTNAME", "TERM", "LANG", "LC_ALL",
+    "HOME", "XDG_CONFIG_HOME", "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY",
+    "NO_PROXY", "PWD", "SHLVL", "OLDPWD", "_",
+    "GOLANG_VERSION", "GOTOOLCHAIN", "GOPATH", "NODE_EXTRA_CA_CERTS",
+}
+
+
+class E6PolicyError(RuntimeError):
+    """Sandbox policy violation — aborts the attempt/preflight (fail closed)."""
+
+
+@dataclass(frozen=True)
+class E6InspectFacts:
+    """What inspect_and_validate observed — recorded in the probe report."""
+
+    network_mode: str
+    user: str
+    readonly_rootfs: bool
+    cap_drop: list[str]
+    security_opt: list[str]
+    group_add: list[str]
+    pids_limit: int
+    memory: int
+    memory_swap: int
+    mounts: list[str]
+    tmpfs: dict[str, str]
+    entrypoint: list[str]
+    env_names: list[str]
+
+
+def build_create_argv(
+    image: str,
+    *,
+    snapshot: Path,
+    run_input: Path,
+    sock_path: Path,
+    script: str,
+) -> list[str]:
+    """The exact frozen E6 docker-create argv (design §1)."""
+    cmd = [
+        "docker", "create",
+        "--workdir", CONTAINER_WORK,
+        "--network", "none",
+        "--user", E6_USER,
+        # Supplementary gid 0: REQUIRED for the provider socket on macOS —
+        # virtiofs presents the bind-mounted host socket as root:root 0660
+        # (host uid/gid are mapped to 0), so gid 0 is the only way uid 10001
+        # may connect(). Inside the container it grants no extra writable
+        # surface: ro rootfs, ro binds, uid-scoped tmpfs (verified
+        # 2026-10-11).
+        "--group-add", "0",
+        "--read-only",
+        "--cap-drop", "ALL",
+        "--security-opt", "no-new-privileges:true",
+        "--pids-limit", E6_PIDS_LIMIT,
+        "--memory", E6_MEMORY,
+        "--memory-swap", E6_MEMORY,
+        "--tmpfs", f"/tmp:{E6_TMPFS_TMP}",
+        "--tmpfs", f"{CONTAINER_RUN_OUTPUT}:{E6_TMPFS_RUN_OUTPUT}",
+        # NOTE: -v src:dst:ro used instead of --mount type=bind,readonly.
+        # Semantically identical in inspect (Mounts[].Type=bind, RW=false),
+        # but Docker Desktop's --mount rejects unix-socket sources at create
+        # time while -v mounts them correctly (verified 2026-10-11).
+        "-v", f"{snapshot.resolve()}:{CONTAINER_WORK}:ro",
+        "-v", f"{run_input.resolve()}:{CONTAINER_RUN_INPUT}:ro",
+        "-v", f"{sock_path.resolve()}:{CONTAINER_SOCK}:ro",
+    ]
+    for name, value in E6_ENV.items():
+        cmd += ["--env", f"{name}={value}"]
+    cmd += ["--entrypoint", E6_GUARD, image, "sh", "-lc", script]
+    return cmd
+
+
+def create_e6_container(
+    image: str,
+    *,
+    snapshot: Path,
+    run_input: Path,
+    sock_path: Path,
+    script: str,
+) -> str:
+    """docker create with the frozen policy; returns the container id."""
+    cmd = build_create_argv(
+        image, snapshot=snapshot, run_input=run_input,
+        sock_path=sock_path, script=script,
+    )
+    try:
+        created = subprocess.run(cmd, capture_output=True, text=True, check=True)
+    except subprocess.CalledProcessError as exc:
+        raise RuntimeError(
+            f"docker create failed: {exc.stderr.strip() or '(no stderr)'}"
+        ) from exc
+    return created.stdout.strip()
+
+
+def inspect_container(cid: str) -> dict:
+    out = subprocess.run(
+        ["docker", "inspect", cid], capture_output=True, text=True, check=True
+    )
+    data = json.loads(out.stdout)
+    return data[0]
+
+
+def inspect_and_validate(cid: str) -> E6InspectFacts:
+    """Verify the CREATED (not yet started) container matches the frozen
+    policy byte-for-byte on every enforced field. Raises E6PolicyError on
+    any mismatch — the container is never started after a violation."""
+    info = inspect_container(cid)
+    host = info.get("HostConfig") or {}
+    cfg = info.get("Config") or {}
+    violations: list[str] = []
+
+    network_mode = host.get("NetworkMode") or ""
+    if network_mode != "none":
+        violations.append(f"NetworkMode must be 'none', got {network_mode!r}")
+    # With --network none docker still records a single 'none' endpoint
+    # (no IP/gateway). Any OTHER attached network is a violation.
+    networks = info.get("NetworkSettings", {}).get("Networks") or {}
+    extra_networks = sorted(set(networks) - {"none"})
+    if extra_networks:
+        violations.append(f"unexpected Networks={extra_networks}")
+
+    user = cfg.get("User") or ""
+    if user != E6_USER:
+        violations.append(f"User={user!r} != {E6_USER!r}")
+
+    if not host.get("ReadonlyRootfs"):
+        violations.append("ReadonlyRootfs is not true")
+
+    cap_drop = host.get("CapDrop") or []
+    if "ALL" not in cap_drop:
+        violations.append(f"CapDrop={cap_drop}")
+
+    security_opt = host.get("SecurityOpt") or []
+    if "no-new-privileges:true" not in security_opt:
+        violations.append(f"SecurityOpt={security_opt}")
+
+    group_add = host.get("GroupAdd") or []
+    if group_add != ["0"]:
+        violations.append(f"GroupAdd={group_add} != ['0']")
+
+    pids = host.get("PidsLimit") or 0
+    if int(pids) != 256:
+        violations.append(f"PidsLimit={pids}")
+
+    memory = int(host.get("Memory") or 0)
+    if memory != 4 * 1024 * 1024 * 1024:
+        violations.append(f"Memory={memory}")
+    memory_swap = int(host.get("MemorySwap") or 0)
+    if memory_swap != 4 * 1024 * 1024 * 1024:
+        violations.append(f"MemorySwap={memory_swap}")
+
+    mounts = []
+    for m in info.get("Mounts") or []:
+        mounts.append(
+            f"{m.get('Destination')}:{m.get('Type')}:{'rw' if m.get('RW') else 'ro'}"
+        )
+        dst = m.get("Destination")
+        if dst in (CONTAINER_WORK, CONTAINER_RUN_INPUT, CONTAINER_SOCK):
+            if m.get("Type") != "bind" or m.get("RW"):
+                violations.append(f"mount {dst} must be a read-only bind: {m}")
+        else:
+            violations.append(f"unexpected mount {dst}")
+    tmpfs = host.get("Tmpfs") or {}
+    for target, required in (("/tmp", E6_TMPFS_TMP), (CONTAINER_RUN_OUTPUT, E6_TMPFS_RUN_OUTPUT)):
+        opts = tmpfs.get(target)
+        if opts is None:
+            violations.append(f"missing tmpfs {target}")
+            continue
+        for tok in required.split(","):
+            if tok not in opts.split(","):
+                violations.append(f"tmpfs {target} missing opt {tok}")
+    extra_tmpfs = set(tmpfs) - {"/tmp", CONTAINER_RUN_OUTPUT}
+    if extra_tmpfs:
+        violations.append(f"unexpected tmpfs {sorted(extra_tmpfs)}")
+
+    entrypoint = cfg.get("Entrypoint") or []
+    if entrypoint != [E6_GUARD]:
+        violations.append(f"Entrypoint={entrypoint}")
+
+    env_names: list[str] = []
+    for kv in cfg.get("Env") or []:
+        name, _, _ = kv.partition("=")
+        env_names.append(name)
+        if any(marker in name.upper() for marker in _FORBIDDEN_ENV_MARKERS):
+            violations.append(f"forbidden env name {name}")
+        elif name not in _ALLOWED_ENV_NAMES:
+            violations.append(f"unexpected env {name}")
+    if any(kv.startswith("OPENAI_API_KEY") for kv in cfg.get("Env") or []):
+        violations.append("OPENAI_API_KEY present in container env")
+
+    if violations:
+        raise E6PolicyError(
+            "E6 inspect-before-start failed for "
+            f"{cid[:12]}: " + "; ".join(violations)
+        )
+    return E6InspectFacts(
+        network_mode=network_mode,
+        user=user,
+        readonly_rootfs=bool(host.get("ReadonlyRootfs")),
+        cap_drop=cap_drop,
+        security_opt=security_opt,
+        group_add=group_add,
+        pids_limit=int(pids),
+        memory=memory,
+        memory_swap=memory_swap,
+        mounts=sorted(mounts + [f"{k}:tmpfs" for k in tmpfs]),
+        tmpfs=dict(tmpfs),
+        entrypoint=entrypoint,
+        env_names=sorted(env_names),
+    )
