+def validate_snapshot(snapshot: Path, *, allow_probe_fixtures: bool = False,
+                      dangling: list | None = None) -> list[str]:
+    """Host-side snapshot hygiene (design §2, refined 2026-10-11, three-way
+    policy matching the analyzer's own VerifyContained semantics):
+
+    - REJECT: symlink whose canonical target exists and lies outside the
+      snapshot root (escape path into host files);
+    - REJECT: non-regular nodes (device/FIFO/socket) and setuid/setgid
+      regular files (escalation vectors);
+    - INERT + RECORDED: symlink that resolves inside the root but is
+      dangling/unresolvable — normal repo testdata content, no escape —
+      appended to ``dangling`` when the holder is given;
+    - ACCEPT: plain exec bits — normal git-checkout content; execution
+      under /work is denied at runtime by the Landlock e6-exec-guard
+      regardless of mode bits (probe exec_denied_work/exec_denied_tmpfs
+      -> EACCES).
+
+    Returns the list of violations (empty = clean). ``allow_probe_fixtures``
+    exempts only the named synthetic fixtures the preflight stages itself.
+    """
+    root = snapshot.resolve()
+    violations: list[str] = []
+    for dirpath, dirnames, filenames in os.walk(root):
+        for name in dirnames + filenames:
+            p = Path(dirpath) / name
+            rel = p.relative_to(root)
+            if allow_probe_fixtures and name in PROBE_FIXTURE_NAMES:
+                continue
+            if p.is_symlink():
+                target = os.path.realpath(p)
+                if not (target == str(root) or target.startswith(str(root) + os.sep)):
+                    violations.append(f"escaping symlink {rel} -> {target}")
+                elif not os.path.exists(p) and dangling is not None:
+                    dangling.append(f"{rel} -> {os.readlink(p)}")
+                continue
+            mode = os.lstat(p).st_mode
+            if not (stat.S_ISREG(mode) or stat.S_ISDIR(mode)):
+                violations.append(f"non-regular file under /work: {rel}")
+            elif stat.S_ISREG(mode) and mode & (stat.S_ISUID | stat.S_ISGID):
+                violations.append(f"setuid/setgid file under /work: {rel}")
+    return violations
+
+
+# Seconds the container lingers after .done so the controller can export
+# tmpfs artifacts via `docker exec` (docker cp cannot read tmpfs on Docker
+# Desktop — verified 2026-10-11).
+E6_EXPORT_GRACE_S = 300
+
+def build_attempt_script(*, model: str, timeout: int, fmt: str = "default") -> str:
+    """Fixed controller script for a live attempt inside the E6 container.
+
+    Starts the loopback->socket relay, runs opencode WITHOUT
+    --dangerously-skip-permissions (removed per design §1/§4), exports the
+    session. No agent-controlled fragments; every argument is fixed/quoted.
+    """
+    model_arg = shlex.quote(model)
+    fmt_arg = shlex.quote(fmt)
+    node_script = (
+        "let s='';"
+        "process.stdin.on('data',d=>s+=d);"
+        "process.stdin.on('end',()=>{"
+        "const rows=JSON.parse(s);"
+        "if(!rows[0]||!rows[0].id) process.exit(1);"
+        "console.log(rows[0].id);"
+        "});"
+    )
+    run_cmd = (
+        f"timeout {int(timeout)}s opencode run --model {model_arg} "
+        f"--format {fmt_arg} --thinking \"$(cat {CONTAINER_PROMPT})\" "
+        "> /tmp/opencode-stdout.txt 2> /tmp/opencode-stderr.log"
+    )
+    session_list_cmd = (
+        "opencode session list --max-count 1 --format json "
+        "> /tmp/session-list.json 2> /tmp/session-list.stderr"
+    )
+    # .done/.rc protocol: the run body executes in a SUBSHELL — dash's
+    # `set -e` inside a plain function aborts the whole script (verified
+    # 2026-10-11), which would skip the marker; a subshell isolates it and
+    # $! survives for the relay kill. .done releases the controller's
+    # export window (docker exec while the container is still alive —
+    # tmpfs content is unreachable through docker cp on Docker Desktop),
+    # and the trailing sleep is the bounded grace period.
+    return f"""
+{E6_RELAY} &
+RELAY_PID=$!
+(
+set -e
+cd /work
+mkdir -p /tmp/.config/opencode
+cp {CONTAINER_CONFIG} /tmp/.config/opencode/opencode.json
+{run_cmd}
+{session_list_cmd}
+node -e {shlex.quote(node_script)} < /tmp/session-list.json > /tmp/session-id
+opencode export "$(cat /tmp/session-id)" > /tmp/opencode-export.json 2> /tmp/opencode-export.stderr
+)
+RC=$?
+kill $RELAY_PID 2>/dev/null || true
+echo $RC > {CONTAINER_RUN_OUTPUT}/.rc
+touch {CONTAINER_RUN_OUTPUT}/.done
+sleep {E6_EXPORT_GRACE_S}
+""".strip()
+
+
+def build_probe_script() -> str:
+    """Fixed in-container probe script: relay up, fixed checks, artifacts."""
+    return f"""
+{E6_RELAY} &
+RELAY_PID=$!
+(
+set -e
+REPORT={CONTAINER_RUN_OUTPUT}/report
+mkdir -p $REPORT
+{E6_PROBE} > $REPORT/probe.json 2> $REPORT/probe.stderr || true
+# deterministic resolved-config proof of the permission matrix (no model)
+mkdir -p /tmp/.config/opencode
+cp {CONTAINER_CONFIG} /tmp/.config/opencode/opencode.json
+HOME=/tmp XDG_CONFIG_HOME=/tmp/.config opencode debug config \\
+  > $REPORT/resolved-config.json 2> $REPORT/resolved-config.stderr || true
+cp $REPORT/probe.json /tmp/e6-probe.json 2>/dev/null || true
+)
+RC=$?
+kill $RELAY_PID 2>/dev/null || true
+echo $RC > {CONTAINER_RUN_OUTPUT}/.rc
+touch {CONTAINER_RUN_OUTPUT}/.done
+sleep {E6_EXPORT_GRACE_S}
+""".strip()
+
