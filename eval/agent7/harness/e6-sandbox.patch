+# ---------------------------------------------------------------------
+# B1/R0 OpenCode config synthesis (design §4)
+# ---------------------------------------------------------------------
+
+# Exact permission object: catch-all FIRST — opencode v1 evaluates the last
+# matching rule, so the explicit allow/deny entries after '*' are what make
+# read/glob/glob work while everything else (present or future) stays denied.
+E6_PERMISSION = {
+    "*": "deny",
+    "read": "allow",
+    "glob": "allow",
+    "grep": "allow",
+    "edit": "deny",
+    "bash": "deny",
+    "webfetch": "deny",
+    "websearch": "deny",
+    "task": "deny",
+    "skill": "deny",
+    "lsp": "deny",
+    "todowrite": "deny",
+    "question": "deny",
+    "external_directory": "deny",
+    "repo_clone": "deny",
+    "repo_overview": "deny",
+}
+
+# The ONLY provider the E6 sandbox may reach: the custom-openai block, with baseURL
+# rewritten to the in-container loopback relay and a dummy key. The real key
+# lives only in the host forwarder.
+E6_PROVIDER = {
+    "npm": "@ai-sdk/openai-compatible",
+    "name": "OpenAI-compatible gateway via E6 forwarder",
+    "options": {
+        "baseURL": "http://127.0.0.1:18080/openai/v1/",
+        "apiKey": "e6-forwarder",
+    },
+}
+
+# Provider-side model ids for the A2 model set (same pins as the C1 custom-openai
+# snippet — context/output limits preserved verbatim).
+E6_MODELS = {
+    "Qwen/Qwen3.6-35B-A3B": {
+        "name": "Qwen3.6-35B-A3B",
+        "limit": {"context": 262144, "output": 16384},
+    },
+    "Qwen/Qwen3.8-27B": {
+        "name": "Qwen3.8-27B",
+        "limit": {"context": 262144, "output": 16384},
+    },
+}
+
+
+def synthesize_e6_config(model_name: str) -> dict:
+    """Effective opencode.json for a B1/R0 attempt.
+
+    ``model_name`` is the MODEL2NAME value (``custom-openai/<provider-model-id>``).
+    Returns the config object — deterministic field order for a stable hash.
+    """
+    provider_name, _, model_key = model_name.partition("/")
+    if provider_name != "custom-openai":
+        raise E6PolicyError(
+            f"E6 config synthesis supports only the custom-openai provider, "
+            f"got model {model_name!r}"
+        )
+    config = {
+        "$schema": "https://opencode.ai/config.json",
+        "permission": dict(E6_PERMISSION),
+        "provider": {
+            "custom-openai": {
+                "npm": E6_PROVIDER["npm"],
+                "name": E6_PROVIDER["name"],
+                "options": dict(E6_PROVIDER["options"]),
+                "models": {
+                    model_key: E6_MODELS.get(model_key, {"name": model_key}),
+                },
+            }
+        },
+    }
+    return config
+
+
+def write_e6_config(config: dict, dest: Path) -> Path:
+    """Write the config deterministically (sorted keys would reorder the
+    permission contract — keep the declared order, stable separators)."""
+    dest.parent.mkdir(parents=True, exist_ok=True)
+    dest.write_text(json.dumps(config, indent=2) + "\n", encoding="utf-8")
+    return dest
+
+
+def config_sha256(config: dict) -> str:
+    return hashlib.sha256(
+        (json.dumps(config, indent=2) + "\n").encode("utf-8")
+    ).hexdigest()
+
+
+def permission_sha256() -> str:
+    return hashlib.sha256(
+        json.dumps(E6_PERMISSION, sort_keys=True).encode("utf-8")
+    ).hexdigest()
+
+
+# ---------------------------------------------------------------------
+# Container lifecycle (watchdog pattern mirrors base.run_in_container)
+# ---------------------------------------------------------------------
+
+def _captured_io(stdout: str | bytes | None, stderr: str | bytes | None) -> str:
+    parts = []
+    for name, value in (("stdout", stdout), ("stderr", stderr)):
+        if value is None:
+            continue
+        text = value if isinstance(value, str) else value.decode("utf-8", "replace")
+        if text.strip():
+            parts.append(f"\n{name} tail:\n{text.strip()[-4000:]}")
+    return "".join(parts)
+
+
+def run_e6_container(
+    image: str,
+    *,
+    script: str,
+    snapshot: Path,
+    run_input: Path,
+    sock_path: Path,
+    timeout: int,
+    artifacts_dir: Path | None,
+    artifact_paths: list[tuple[str, str]],
+    io_log_dir: Path | None = None,
+    validate_snapshot_hygiene: bool = True,
+    inspect_holder: list | None = None,
+) -> tuple[str | bytes | None, str | bytes | None]:
+    """Create -> inspect/validate -> start (watchdog) -> export -> rm.
+
+    Returns (stdout, stderr) captures. Raises RuntimeError/E6PolicyError on
+    any failure; the container is always removed and the forwarder socket is
+    the caller's responsibility (caller owns its lifecycle). When
+    ``inspect_holder`` (a list) is given, the E6InspectFacts from the
+    inspect-before-start validation are appended to it.
+    """
+    if validate_snapshot_hygiene:
+        violations = validate_snapshot(snapshot)
+        if violations:
+            raise E6PolicyError(
+                f"snapshot {snapshot} failed E6 hygiene: "
+                + "; ".join(violations)
+            )
+
+    cid = create_e6_container(
+        image, snapshot=snapshot, run_input=run_input,
+        sock_path=sock_path, script=script,
+    )
+    stdout_cap: str | bytes | None = None
+    stderr_cap: str | bytes | None = None
+    live_exported = False
+    try:
+        # Inspect BEFORE start — a policy mismatch aborts the attempt before
+        # any code inside the container runs.
+        facts = inspect_and_validate(cid)
+        if inspect_holder is not None:
+            inspect_holder.append(facts)
+
+        started = subprocess.run(
+            ["docker", "start", cid], capture_output=True, text=True,
+        )
+        if started.returncode != 0:
+            raise RuntimeError(
+                "docker start failed: " + (started.stderr.strip() or "(no stderr)")
+            )
+
+        logs = {"done": threading.Event(), "text": ""}
+
+        def _pump_logs() -> None:
+            p = subprocess.run(
+                ["docker", "logs", "-f", cid],
+                capture_output=True, text=True,
+            )
+            logs["text"] = p.stdout or ""
+            logs["done"].set()
+
+        log_thread = threading.Thread(target=_pump_logs, daemon=True)
+        log_thread.start()
+
+        # Wait for the .done marker (run body finished, export window open)
+        # or container exit, whichever comes first — with a watchdog that
+        # kills the container so the marker path can never hang us.
+        deadline = time.monotonic() + timeout + E6_EXPORT_GRACE_S + 60
+        timed_out = False
+        done = False
+        exited = False
+        while time.monotonic() < deadline:
+            r = subprocess.run(
+                ["docker", "exec", cid, "test", "-f",
+                 f"{CONTAINER_RUN_OUTPUT}/.done"],
+                capture_output=True, timeout=30,
+            )
+            if r.returncode == 0:
+                done = True
+                break
+            insp = subprocess.run(
+                ["docker", "inspect", "-f", "{{.State.Running}}", cid],
+                capture_output=True, text=True,
+            )
+            if "false" in (insp.stdout or ""):
+                exited = True
+                break
+            time.sleep(0.5)
+        else:
+            timed_out = True
+
+        # Exit code: read the recorded .rc BEFORE killing the container —
+        # docker wait after a kill reports 137, not the script's rc.
+        rc = None
+        if timed_out:
+            subprocess.run(
+                ["docker", "kill", cid], capture_output=True, check=False)
+        elif done and not exited:
+            rr = subprocess.run(
+                ["docker", "exec", cid, "cat", f"{CONTAINER_RUN_OUTPUT}/.rc"],
+                capture_output=True, text=True, timeout=30,
+            )
+            if rr.returncode == 0:
+                try:
+                    rc = int(rr.stdout.strip())
+                except ValueError:
+                    rc = None
+            # Export while the container is still alive in its grace sleep —
+            # docker cp cannot read tmpfs on Docker Desktop; docker exec can.
+            # Unconditional on rc: failed attempts need their artifacts too.
+            if artifacts_dir is not None:
+                _export_artifacts_exec(cid, artifacts_dir, artifact_paths)
+                live_exported = True
+            subprocess.run(
+                ["docker", "kill", cid], capture_output=True, check=False)
+        elif done and exited:
+            # Container already left: .rc gone with the tmpfs; rc stays None
+            # and falls back to docker wait's true exit code.
+            pass
+
+        wait = subprocess.run(
+            ["docker", "wait", cid], capture_output=True, text=True, timeout=60,
+        )
+        if rc is None:
+            try:
+                rc = int(wait.stdout.strip())
+            except ValueError:
+                rc = -1
+        log_thread.join(timeout=10)
+        stdout_cap = logs["text"]
+
+        if timed_out:
+            raise RuntimeError(
+                f"e6 container timed out after {timeout}s"
+                f"{_captured_io(stdout_cap, None)}"
+            )
+        if rc != 0:
+            raise RuntimeError(
+                f"e6 container exited {rc}: "
+                f"{_captured_io(stdout_cap, None)}"
+            )
+        return stdout_cap, None
+    finally:
+        if io_log_dir is not None:
+            _write_io_logs(io_log_dir, stdout_cap, stderr_cap)
+        if artifacts_dir is not None and not live_exported:
+            # Fallback: docker cp for whatever is reachable post-stop
+            # (bind-mounted layer only — tmpfs contents are gone).
+            _copy_container_artifacts(cid, artifacts_dir, artifact_paths)
+        subprocess.run(["docker", "rm", "-f", cid], capture_output=True, check=False)
+
+
+def _export_artifacts_exec(
+    cid: str, artifacts_dir: Path, artifact_paths: list[tuple[str, str]]
+) -> None:
+    """Export artifacts from a LIVE container via docker exec.
+
+    Docker Desktop's `docker cp` cannot read tmpfs content (the /tmp and
+    /run-output mounts — verified 2026-10-11), so each file is `cat`'d out
+    and each directory is exported as `tar`. Failures are recorded in
+    export-report.json exactly like _copy_container_artifacts."""
+    artifacts_dir.mkdir(parents=True, exist_ok=True)
+    report: list[dict] = []
+    for container_path, name in artifact_paths:
+        dest = artifacts_dir / name
+        if dest.exists():
+            if dest.is_dir():
+                shutil.rmtree(dest)
+            else:
+                dest.unlink()
+        probe = subprocess.run(
+            ["docker", "exec", cid, "test", "-d", container_path],
+            capture_output=True, timeout=30,
+        )
+        if probe.returncode == 0:
+            # directory -> tar export
+            tar = subprocess.run(
+                ["docker", "exec", cid, "tar", "-C", "/", "-cf", "-",
+                 container_path.lstrip("/")],
+                capture_output=True, timeout=120,
+            )
+            if tar.returncode == 0:
+                dest.mkdir(parents=True, exist_ok=True)
+                extract = subprocess.run(
+                    ["tar", "-xf", "-", "-C", str(dest), "--strip-components",
+                     str(container_path.strip("/").count("/") + 1)],
+                    input=tar.stdout, capture_output=True, timeout=60,
+                )
+                rc, err = extract.returncode, (extract.stderr or b"")[-500:]
+            else:
+                rc, err = tar.returncode, (tar.stderr or b"")[-500:]
+            report.append({
+                "container_path": container_path, "name": name,
+                "rc": rc, "stderr": err.decode("utf-8", "replace")
+                if isinstance(err, bytes) else str(err),
+                "exported": dest.exists() and any(dest.iterdir()),
+            })
+        else:
+            cat = subprocess.run(
+                ["docker", "exec", cid, "cat", container_path],
+                capture_output=True, timeout=120,
+            )
+            if cat.returncode == 0:
+                dest.write_bytes(cat.stdout)
+            report.append({
+                "container_path": container_path, "name": name,
+                "rc": cat.returncode,
+                "stderr": (cat.stderr or b"").decode("utf-8", "replace")[-500:],
+                "exported": dest.exists(),
+            })
+    (artifacts_dir / "export-report.json").write_text(
+        json.dumps(report, indent=2) + "\n", encoding="utf-8")
