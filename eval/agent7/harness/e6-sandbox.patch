+	guarded("runtime_limits", "CapEff=0 pids=256 mem=4g swap=4g", checkCapsPidsMemory)
+	guarded("exec_denied_work", "EACCES", checkExecDeniedWork)
+	guarded("exec_denied_tmpfs", "EACCES", checkExecDeniedTmpfs)
+	guarded("snapshot_write", "EROFS", checkSnapshotWrite)
+	guarded("closed_path_read", "ENOENT", checkClosedPathRead)
+	guarded("symlink_escape", "ENOENT", checkSymlinkEscape)
+	guarded("secret_exposure", "no key/env-file/indirection", checkSecretExposure)
+	guarded("interfaces_loopback_only", "lo only", checkInterfaces)
+	guarded("egress_tcp", "dial failure", checkEgressTCP)
+	guarded("egress_host", "dial failure", checkEgressHost)
+	guarded("dns", "lookup+udp53 failure", checkDNS)
+	guarded("forwarder_rejects", "403 x-e6-reject", checkForwarderRejects)
+	guarded("provider_models", "2xx via relay", checkProviderModels)
+	guarded("product_exec", "build/run denied", checkProductExec)
+	guarded("opencode_version", wantOpencodeV, checkOpencodeVersion)
+
+	rep := probeReport{Probe: "e6-probe/1", SelfSHA256: selfSHA256(), Checks: checks}
+	enc := json.NewEncoder(os.Stdout)
+	enc.SetIndent("", "  ")
+	_ = enc.Encode(rep)
+}
diff --git a/docker/e6-helpers/cmd/e6-relay/main.go b/docker/e6-helpers/cmd/e6-relay/main.go
new file mode 100644
index 0000000..88215d2
--- /dev/null
+++ b/docker/e6-helpers/cmd/e6-relay/main.go
@@ -0,0 +1,72 @@
+// e6-relay: fixed loopback -> Unix-socket byte relay for the E6 sandbox.
+//
+// Listens ONLY on 127.0.0.1:18080 and copies each accepted TCP connection to
+// the host-provided provider forwarder socket at /run/provider.sock. The
+// container has --network none, so loopback is the only interface; this relay
+// is the sole path from in-container HTTP clients to the host forwarder.
+//
+// One fixed purpose, no flags: the listen address and socket path are
+// constants so the runtime pin cannot be widened by arguments.
+package main
+
+import (
+	"fmt"
+	"io"
+	"net"
+	"os"
+	"sync"
+	"time"
+)
+
+const (
+	listenAddr  = "127.0.0.1:18080"
+	sockPath    = "/run/provider.sock"
+	dialTimeout = 10 * time.Second
+	ioTimeout   = 15 * time.Minute
+)
+
+func main() {
+	ln, err := net.Listen("tcp", listenAddr)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "e6-relay: listen %s: %v\n", listenAddr, err)
+		os.Exit(1)
+	}
+	fmt.Fprintf(os.Stderr, "e6-relay: listening on %s -> %s\n", listenAddr, sockPath)
+	for {
+		conn, err := ln.Accept()
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "e6-relay: accept: %v\n", err)
+			continue
+		}
+		go handle(conn)
+	}
+}
+
+func handle(client net.Conn) {
+	defer client.Close()
+	upstream, err := net.DialTimeout("unix", sockPath, dialTimeout)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "e6-relay: dial %s: %v\n", sockPath, err)
+		return
+	}
+	defer upstream.Close()
+
+	var wg sync.WaitGroup
+	wg.Add(2)
+	go pump(&wg, upstream, client) // client -> upstream
+	go pump(&wg, client, upstream) // upstream -> client
+	wg.Wait()
+}
+
+func pump(wg *sync.WaitGroup, dst net.Conn, src net.Conn) {
+	defer wg.Done()
+	_ = src.SetDeadline(time.Now().Add(ioTimeout))
+	_, _ = io.Copy(dst, src)
+	// Propagate half-close so the peer sees end-of-body promptly.
+	if tc, ok := dst.(*net.TCPConn); ok {
+		_ = tc.CloseWrite()
+	}
+	if uc, ok := dst.(*net.UnixConn); ok {
+		_ = uc.CloseWrite()
+	}
+}
