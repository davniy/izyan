+def _read_response_head(s: socket.socket) -> tuple[bytes, bytes]:
+    data = b""
+    while b"\r\n\r\n" not in data:
+        data += s.recv(65536)
+        assert data, "connection closed before response headers"
+    head, _, rest = data.partition(b"\r\n\r\n")
+    return head, rest
+
