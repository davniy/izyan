+def test_expect_100_continue(scripted_forwarder):
+    """Client withholds the body until interim 100 — must not deadlock."""
+    got = {}
+
+    def script(srv):
+        data = b""
+        while b"\r\n\r\n" not in data:
+            data += srv.recv(65536)
+        _, _, body = data.partition(b"\r\n\r\n")
+        while len(body) < 5:
+            body += srv.recv(65536)
+        got["body"] = body[:5]
+        srv.sendall(b"HTTP/1.1 200 OK\r\ncontent-length: 2\r\n\r\nok")
+        srv.close()
+
+    f = scripted_forwarder(script)
+    s = socket.socket(socket.AF_UNIX)
+    s.settimeout(15)
+    s.connect(str(f.sock_path))
+    s.sendall(
+        b"POST /openai/v1/chat/completions HTTP/1.1\r\n"
+        b"Host: 127.0.0.1:18080\r\nContent-Length: 5\r\n"
+        b"Expect: 100-continue\r\n\r\n"
+    )
+    # interim 100 arrives, then the client sends the body
+    data = s.recv(4096)
+    assert b"100 Continue" in data
+    s.sendall(b"hello")
+    head, rest = _read_response_head(s)
+    assert b"200" in head
+    assert rest == b"ok"
+    assert got["body"] == b"hello"
+    s.close()
+    f.stop()
+
