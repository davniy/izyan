+func checkEgressTCP() (bool, string, string) {
+	var obs []string
+	ok := true
+	for _, target := range []string{"1.1.1.1:443", "8.8.8.8:443"} {
+		c, err := net.DialTimeout("tcp", target, 5*time.Second)
+		if err == nil {
+			c.Close()
+			ok = false
+			obs = append(obs, target+"=CONNECTED(VIOLATION)")
+			continue
+		}
+		obs = append(obs, target+"="+dialErrSummary(err))
+	}
+	return ok, strings.Join(obs, ","), "all dials must fail"
+}
+
+func checkEgressHost() (bool, string, string) {
+	c, err := net.DialTimeout("tcp", "example.com:443", 8*time.Second)
+	if err == nil {
+		c.Close()
+		return false, "CONNECTED", "egress to arbitrary host succeeded — violation"
+	}
+	return true, dialErrSummary(err), "expected dial failure (no DNS/route)"
+}
+
+func checkDNS() (bool, string, string) {
+	var obs []string
+	ok := true
+	_, err := net.LookupHost("example.com")
+	if err == nil {
+		ok = false
+		obs = append(obs, "lookup=SUCCEEDED(VIOLATION)")
+	} else {
+		obs = append(obs, "lookup="+dialErrSummary(err))
+	}
+	c, err := net.DialTimeout("udp", "8.8.8.8:53", 5*time.Second)
+	if err == nil {
+		c.SetDeadline(time.Now().Add(3 * time.Second))
+		if _, werr := c.Write([]byte{0}); werr == nil {
+			ok = false
+			obs = append(obs, "udp53-write=SUCCEEDED(VIOLATION)")
+		} else {
+			obs = append(obs, "udp53="+dialErrSummary(werr))
+		}
+		c.Close()
+	} else {
+		obs = append(obs, "udp53="+dialErrSummary(err))
+	}
+	return ok, strings.Join(obs, ","), "DNS must be impossible"
+}
+
+// --------------------------------------------------------------------
+// Forwarder channel (the ONLY allowed egress)
+// --------------------------------------------------------------------
+
+func rawUnixHTTP(req string) (int, string, error) {
+	conn, err := net.DialTimeout("unix", providerSock, 5*time.Second)
+	if err != nil {
+		return 0, "", err
+	}
+	defer conn.Close()
+	conn.SetDeadline(time.Now().Add(20 * time.Second))
+	if _, err := conn.Write([]byte(req)); err != nil {
+		return 0, "", err
+	}
+	data, _ := io.ReadAll(io.LimitReader(conn, 64<<10))
+	head := string(data)
+	status := 0
+	if i := strings.Index(head, " "); i > 0 {
+		fmt.Sscanf(head[:i+4], "HTTP/1.1 %d", &status)
+	}
+	return status, head, nil
+}
+
+func isReject(status int, head string) bool {
+	return status == 403 && strings.Contains(head, "x-e6-reject:")
+}
+
+func checkForwarderRejects() (bool, string, string) {
+	cases := []struct {
+		name string
+		req  string
+	}{
+		{"foreign_host", "GET /openai/v1/models HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"},
+		{"connect", "CONNECT example.com:443 HTTP/1.1\r\nHost: example.com\r\nConnection: close\r\n\r\n"},
+		{"absolute_form", "GET http://example.com/x HTTP/1.1\r\nHost: <corporate-provider-host>\r\nConnection: close\r\n\r\n"},
+		{"disallowed_path", "GET /openai/v1/admin/keys HTTP/1.1\r\nHost: <corporate-provider-host>\r\nConnection: close\r\n\r\n"},
+		{"disallowed_method", "DELETE /openai/v1/models HTTP/1.1\r\nHost: <corporate-provider-host>\r\nConnection: close\r\n\r\n"},
+		{"relative_traversal", "GET /openai/v1/../v2/admin HTTP/1.1\r\nHost: <corporate-provider-host>\r\nConnection: close\r\n\r\n"},
+		{"out_of_prefix", "GET /v1/models HTTP/1.1\r\nHost: <corporate-provider-host>\r\nConnection: close\r\n\r\n"},
+	}
+	var bad []string
+	var obs []string
+	for _, c := range cases {
+		status, head, err := rawUnixHTTP(c.req)
+		if err != nil {
+			obs = append(obs, c.name+"=dialerr:"+errName(err))
+			continue
+		}
+		if !isReject(status, head) {
+			bad = append(bad, fmt.Sprintf("%s=status%d", c.name, status))
+		}
+		obs = append(obs, fmt.Sprintf("%s=%d", c.name, status))
+	}
+	// Oversized headers must be rejected/dropped (forwarder closes early).
+	big := "GET /openai/v1/models HTTP/1.1\r\nHost: <corporate-provider-host>\r\nX-Pad: " + strings.Repeat("A", 70<<10) + "\r\n\r\n"
+	status, head, err := rawUnixHTTP(big)
+	if err != nil {
+		obs = append(obs, "oversize=closed:"+errName(err))
+	} else {
+		obs = append(obs, fmt.Sprintf("oversize=%d", status))
+		if isReject(status, head) || status == 431 || status == 400 || status == 0 {
+			// rejected or connection dropped — both acceptable
+		} else {
+			bad = append(bad, fmt.Sprintf("oversize=%d", status))
+		}
+	}
+	return len(bad) == 0, strings.Join(obs, " "), "non-403s: " + strings.Join(bad, ",")
+}
+
+func checkProviderModels() (bool, string, string) {
+	// Through the same loopback relay opencode uses.
+	client := &http.Client{Timeout: 30 * time.Second}
+	resp, err := client.Get(relayBase + "/openai/v1/models")
+	if err != nil {
+		return false, dialErrSummary(err), "relay/provider request failed"
+	}
+	defer resp.Body.Close()
+	body, _ := io.ReadAll(io.LimitReader(resp.Body, 512))
+	statusOK := resp.StatusCode >= 200 && resp.StatusCode < 300
+	return statusOK, fmt.Sprintf("status=%d", resp.StatusCode),
+		"body head: " + truncate(string(body), 200)
+}
