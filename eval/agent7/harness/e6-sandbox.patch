@@ -0,0 +1,51 @@
+"""Agent7 A2 prompt-arm pins: frozen hashes and the r0 = b1 + delta identity."""
+
+import hashlib
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+from evaluate.prompts import PROMPTS  # noqa: E402
+
+# Frozen pins (izyan repo eval/agent7/prompts/{b1,r0}.txt).
+B1_SHA256 = "e10e2a922c2e37ba86ca5e673b4936f8e84316bae3ca6e6d043d8285db548b09"
+R0_SHA256 = "dba37365ea24a63bdd349eaa8325514a0872b8340f1ca4954e0985e28af6097a"
+# sha256 of the treatment delta (r0 with the b1 prefix removed).
+DELTA_SHA256 = "58a08278eaa5e497252b808b6ada03e351993c99808b2429469917c4ce72dbab"
+
+
+def _sha256(text: str) -> str:
+    return hashlib.sha256(text.encode("utf-8")).hexdigest()
+
+
+def test_b1_hash_matches_pin() -> None:
+    assert _sha256(PROMPTS["b1"]) == B1_SHA256
+
+
+def test_r0_hash_matches_pin() -> None:
+    assert _sha256(PROMPTS["r0"]) == R0_SHA256
+
+
+def test_r0_is_b1_plus_delta() -> None:
+    """r0 = b1 bytes + two LF + the <RESEARCH_ASSESSMENT> treatment block.
+
+    b1 ends in a single LF, so at file level the delta is one additional
+    LF (the blank line) followed by the block; equivalently, r0 is
+    b1-without-trailing-LF + "\\n\\n" + <RESEARCH_ASSESSMENT> block.
+    """
+    b1 = PROMPTS["b1"]
+    r0 = PROMPTS["r0"]
+
+    assert r0.startswith(b1)
+    delta = r0[len(b1):]
+    assert _sha256(delta) == DELTA_SHA256
+
+    # Brief form: r0 == b1 + "\n\n" + delta-block (b1's trailing LF counted).
+    delta_block = delta.lstrip("\n")
+    assert delta_block.startswith("<RESEARCH_ASSESSMENT>\n")
+    assert delta_block.rstrip("\n").endswith("</RESEARCH_ASSESSMENT>")
+    assert r0 == b1.rstrip("\n") + "\n\n" + delta_block
+
+    # Exactly one blank line separates b1 and the block.
+    assert delta == "\n" + delta_block
