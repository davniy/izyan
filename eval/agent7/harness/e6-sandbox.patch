+	if err == nil {
+		f.Close()
+		os.Remove(workDir + "/.e6-write-probe") // best-effort; should not have existed
+	}
+	expect("create", err)
+	// truncate existing
+	f2, err := os.OpenFile(workDir+"/README.e6", os.O_WRONLY|os.O_TRUNC, 0o644)
+	if err == nil {
+		f2.Close()
