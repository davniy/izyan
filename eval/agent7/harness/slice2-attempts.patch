--- a/tests/test_attempts.py
+++ b/tests/test_attempts.py
@@ -0,0 +1,182 @@
+"""Slice-2 attempt/retry model (design §2.7).
+
+An unparseable cached result is preserved next to ``retry-reason.txt``
+and the retry lands in its own ``run_NNN_rK`` directory — never an
+in-place overwrite. A parseable result in any earlier attempt still
+cache-skips, and ``run_NNN`` keeps the first attempt's attempt key.
+"""
+
+import argparse
+import json
+import sys
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "src"))
+
+from evaluate import run as runmod  # noqa: E402
+from evaluate.agents.base import AgentResult  # noqa: E402
+from evaluate.agents.opencode import OpenCodeAgent  # noqa: E402
+from evaluate.common import ExperimentConfig, config_from_args  # noqa: E402
+
+
+def _config(tmp_path: Path, task_file: Path) -> ExperimentConfig:
+    prompt = tmp_path / "prompt.txt"
+    prompt.write_text("T={task_id} END", encoding="utf-8")
+    parser = argparse.ArgumentParser(prog="vex-bench evaluate run")
+    subs = parser.add_subparsers(dest="evaluate_cmd", required=True)
+    runmod.register_parser(subs)
+    args = parser.parse_args(
+        [
+            "run",
+            "--model",
+            "m1",
+            "--agent",
+            "opencode",
+            "--benchmark-file",
+            str(task_file),
+            "--prompt-file",
+            str(prompt),
+            "--output-dir",
+            str(tmp_path / "out"),
+        ]
+    )
+    return config_from_args(args)
+
+
+def _task(tmp_path: Path) -> dict:
+    snapshot = tmp_path / "snap"
+    snapshot.mkdir()
+    task = {
+        "task_id": "research-smoke1",
+        "cve_id": "CVE-2099-0001",
+        "repo_url": "https://local.invalid/research",
+        "commit_sha": "deadbeef" * 5,
+        "snapshot_path": str(snapshot),
+        "metadata": {"language": "go"},
+    }
+    (tmp_path / "one.jsonl").write_text(json.dumps(task) + "\n", encoding="utf-8")
+    return task
+
+
+_VALID_RAW = json.dumps(
+    {
+        "messages": [
+            {
+                "info": {"role": "assistant"},
+                "parts": [
+                    {
+                        "type": "text",
+                        "text": '{"category": "vulnerable", "reasoning": "r"}',
+                    }
+                ],
+            }
+        ]
+    }
+)
+
+
+class _ScriptedAgent(OpenCodeAgent):
+    """Real OpenCodeAgent parsing; run() replays scripted raw outputs."""
+
+    def __init__(self, outputs: list[str]) -> None:
+        self.outputs = list(outputs)
+        self.ran = 0
+
+    def run(self, prompt: str, ctx) -> AgentResult:
+        self.ran += 1
+        return AgentResult(raw_output=self.outputs.pop(0))
+
+
+def test_invalid_cached_result_preserved_and_retry_in_new_dir(tmp_path):
+    task = _task(tmp_path)
+    cfg = _config(tmp_path, tmp_path / "one.jsonl")
+    agent = _ScriptedAgent(["corrupted-bytes-not-a-result", _VALID_RAW])
+
+    # First attempt: the agent produces an unparseable result.
+    runmod._run_one(task, 1, config=cfg, agent=agent)
+    run_001 = cfg.run_dir / task["task_id"] / "run_001"
+    original = run_001 / "result.json"
+    assert original.exists()
+    original_bytes = original.read_bytes()
+
+    # Invoking the run stage again must NOT overwrite run_001.
+    runmod._run_one(task, 1, config=cfg, agent=agent)
+
+    # Original result preserved byte-identical under a moved-aside name.
+    assert not original.exists()
+    kept = sorted(run_001.glob("result.invalid-*.json"))
+    assert len(kept) == 1
+    assert kept[0].read_bytes() == original_bytes
+
+    # Reason file names the parse failure.
+    reason = (run_001 / "retry-reason.txt").read_text(encoding="utf-8")
+    assert "result.json" in reason
+    assert "no category" in reason
+
+    # Retry landed in its own directory with the valid second output.
+    run_r2 = cfg.run_dir / task["task_id"] / "run_001_r2"
+    assert (run_r2 / "result.json").exists()
+    assert agent.ran == 2
+
+    # History lists both attempts with reason + preserved path.
+    history = [
+        json.loads(line)
+        for line in (run_001 / "attempts.jsonl").read_text().splitlines()
+    ]
+    assert [h["id"] for h in history] == ["run_001", "run_001_r2"]
+    assert history[0]["reason_code"] == "initial"
+    retry = history[1]
+    assert retry["reason_code"] == "invalid_extraction"
+    assert retry["retry_of"] == "run_001"
+    assert retry["original_preserved"] is True
+    assert retry["preserved_original_paths"] == [
+        f"{task['task_id']}/run_001/{kept[0].name}"
+    ]
+
+    # Third invocation: the retry's result is parseable -> cache-skip.
+    runmod._run_one(task, 1, config=cfg, agent=agent)
+    assert agent.ran == 2
+    assert not (cfg.run_dir / task["task_id"] / "run_001_r3").exists()
+
+
+def test_parseable_cached_result_is_cache_skipped(tmp_path):
+    task = _task(tmp_path)
+    cfg = _config(tmp_path, tmp_path / "one.jsonl")
+    agent = _ScriptedAgent([_VALID_RAW])
+
+    runmod._run_one(task, 1, config=cfg, agent=agent)
+    first = cfg.run_dir / task["task_id"] / "run_001" / "result.json"
+    before = first.read_bytes()
+
+    runmod._run_one(task, 1, config=cfg, agent=agent)
+    assert agent.ran == 1
+    assert first.read_bytes() == before
+    assert not (cfg.run_dir / task["task_id"] / "run_001_r2").exists()
+
+
+def test_error_attempt_retries_into_new_dir(tmp_path):
+    """An agent error is also an attempt: the retry still gets its own dir."""
+    task = _task(tmp_path)
+    cfg = _config(tmp_path, tmp_path / "one.jsonl")
+
+    class _Failing(_ScriptedAgent):
+        def run(self, prompt, ctx):
+            self.ran += 1
+            raise RuntimeError("container boom")
+
+    agent = _Failing([_VALID_RAW])
+    runmod._run_one(task, 1, config=cfg, agent=agent)
+    run_001 = cfg.run_dir / task["task_id"] / "run_001"
+    assert (run_001 / "error.txt").exists()
+
+    agent2 = _ScriptedAgent([_VALID_RAW])
+    runmod._run_one(task, 1, config=cfg, agent=agent2)
+    assert (run_001 / "error.txt").exists()  # first attempt untouched
+    assert (cfg.run_dir / task["task_id"] / "run_001_r2" / "result.json").exists()
+
+    history = [
+        json.loads(line)
+        for line in (run_001 / "attempts.jsonl").read_text().splitlines()
+    ]
+    assert history[1]["reason_code"] == "infrastructure_failure"
+    assert history[1]["retry_of"] == "run_001"
