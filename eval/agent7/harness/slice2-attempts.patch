 PROMPT_TASK_FIELDS = ("task_id", "cve_id", "repo_url", "commit_sha")
 
 
+# Attempt/retry model (slice 2 design §2.7): the first attempt for a
+# (task, rep) pair runs in ``run_NNN`` and owns the plain attempt key.
+# Every re-invocation after that — invalid result, agent error, or an
+# interrupted attempt — runs in a distinct sibling ``run_NNN_r2``,
+# ``run_NNN_r3``, … directory. An unparseable result file is never
+# overwritten: it is renamed ``<name>.invalid-<utc><suffix>`` next to a
+# ``retry-reason.txt``, and every attempt is appended to
+# ``run_NNN/attempts.jsonl`` so the downstream reader can list the full
+# history. Nothing is ever retried inside the run stage itself — a new
+# attempt exists only because the stage was invoked again.
+ATTEMPT_HISTORY = "attempts.jsonl"
+RETRY_REASON_FILE = "retry-reason.txt"
+
+# Candidate result basenames, same set ``load_result``/``has_result``
+# probe: the agent's own ``result_filename`` plus the two names in use
+# across agent profiles. Anything outside this set is not a cached
+# result and is left untouched.
+_RESULT_BASENAMES = ("result.json", "result.jsonl")
+
+
+def _attempt_dirs(task_dir: Path, run_id: str) -> list[Path]:
+    """Existing attempt directories for one (task, rep) pair, oldest first.
+
+    ``run_id`` itself is ordinal 1; retries are ``run_id_r2`` and up,
+    numbered by attempt ordinal rather than a count of failures.
+    """
+    attempts = [task_dir / run_id] if (task_dir / run_id).is_dir() else []
+    ordinal = 2
+    while (task_dir / f"{run_id}_r{ordinal}").is_dir():
+        attempts.append(task_dir / f"{run_id}_r{ordinal}")
+        ordinal += 1
+    return attempts
+
+
+def _result_files(agent: Agent, attempt_dir: Path) -> list[Path]:
+    """Cached-result candidates present in an attempt directory."""
+    names = {agent.result_filename(), *_RESULT_BASENAMES}
+    return [
+        attempt_dir / name
+        for name in sorted(names)
+        if (attempt_dir / name).is_file()
+    ]
+
+
+def _parse_failure_reason(agent: Agent, path: Path) -> str:
+    """Why ``load_result`` rejects this file — mirrors ``_load_result_file``."""
+    try:
+        if path.stat().st_size == 0:
+            return "empty result file"
+        raw = path.read_text(encoding="utf-8")
+        text = agent.extract_text(raw)
+        category, _reasoning = parse_category(text)
+    except Exception as exc:
+        return f"{type(exc).__name__}: {exc}"
+    if category is None:
+        return "no category found in agent output"
+    return "result parses but was not accepted by load_result"
+
+
+def _preserve_attempt(agent: Agent, attempt_dir: Path) -> tuple[list[Path], str]:
+    """Move unparseable result files aside; return (preserved, reason)."""
+    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
+    preserved: list[Path] = []
+    reasons: list[str] = []
+    for path in _result_files(agent, attempt_dir):
+        reason = _parse_failure_reason(agent, path)
+        kept = attempt_dir / f"{path.stem}.invalid-{stamp}{path.suffix}"
+        path.rename(kept)
+        preserved.append(kept)
+        reasons.append(f"{path.name}: {reason} (preserved as {kept.name})")
+    if preserved:
+        (attempt_dir / RETRY_REASON_FILE).write_text(
+            "cached result preserved; next attempt runs in a new directory\n"
+            + "\n".join(reasons)
+            + "\n",
+            encoding="utf-8",
+        )
+    return preserved, "; ".join(reasons)
+
+
+def _retry_reason(attempt_dir: Path, preserved: list[Path], detail: str) -> tuple[str, str]:
+    """(reason_code, reason) for the attempt that replaces ``attempt_dir``."""
+    if preserved:
+        return "invalid_extraction", f"cached result unparseable: {detail}"
+    if (attempt_dir / "error.txt").is_file():
+        return "infrastructure_failure", "previous attempt ended in error.txt"
+    return "other", "previous attempt produced no result"
+
+
+def _record_attempt(
+    history_path: Path,
+    *,
+    attempt_id: str,
+    task_id: str,
+    ordinal: int,
+    reason_code: str,
+    reason: str,
+    retry_of: str | None,
+    preserved: list[Path],
+    run_dir: Path,
+) -> None:
+    """Append one attempt record to the JSONL history (design §2.7)."""
+    record = {
+        "id": attempt_id,
+        "kind": "agent",
+        "ordinal": ordinal,
+        "task_id": task_id,
+        "started_at": datetime.now(timezone.utc).isoformat(),
+        "reason_code": reason_code,
+        "reason": reason,
+        "retry_of": retry_of,
+        "original_preserved": bool(preserved),
+        "preserved_original_paths": [
+            str(p.relative_to(run_dir)) for p in preserved
+        ],
+    }
+    with history_path.open("a", encoding="utf-8") as f:
+        f.write(json.dumps(record, ensure_ascii=False) + "\n")
+
