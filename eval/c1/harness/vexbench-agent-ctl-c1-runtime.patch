new file mode 100644
index 0000000..2eac14c
--- /dev/null
+++ b/src/evaluate/agents/codex_c1.py
@@ -0,0 +1,184 @@
+"""Task 4 (C1) Codex adapters — additive profiles, B1 semantics preserved.
+
+Two registry entries:
+
+- ``codex-b1p`` (B1' control): identical to B1's ``codex`` — same model,
+  image, args, mounts, native tools — PLUS the shared structured-assessment
+  prompt (``vuln_assess``) and full stdout/stderr + artifact capture.
+  Use this as the primary comparator when the reporting protocol is new
+  (plan §1.5): same output contract, no Izyan tools anywhere.
+
+- ``codex-c1`` (C1 treatment): B1' + the ``izyan`` MCP evidence-tools
+  server. The frozen base image is extended by a derived image
+  ``vex-bench-go-codex-c1:latest`` (docker/go.codex-c1.Dockerfile) that only
+  adds ``/usr/local/bin/izyan-evidence-tools``; the MCP stanza is appended
+  to a per-attempt synthesized config.toml. Native Codex coding tools,
+  model, sandbox mode, env file and image entrypoint are unchanged.
+
+Neither profile touches ``opencode``/``claude``/``codex`` semantics.
+"""
+
+import logging
+import re
+from pathlib import Path
+
+from evaluate.agents.base import AgentResult, RunContext, run_in_container
+from evaluate.agents.codex import CodexAgent, CONTAINER_CONFIG, HOST_CONFIG, HOST_ENV_FILE
+
+logger = logging.getLogger(__name__)
+
+# Where the derived C1 image keeps the tool binary (docker/go.codex-c1.Dockerfile).
+TOOL_BIN_CONTAINER = "/usr/local/bin/izyan-evidence-tools"
+# Container-local, attempt-local audit sink; exported via artifact_paths.
+TOOL_AUDIT_DIR = "/tmp/izyan-audit"
+# Codex session/rollout records land under $CODEX_HOME (HOME=/tmp in image).
+CODEX_STATE_DIR = "/tmp/.codex"
+
+_CVE_TAG_RE = re.compile(r"<CVE>\s*([A-Za-z]+-\d[\w.-]*)\s*</CVE>")
+
+
+def _extract_cve_id(prompt: str) -> str | None:
+    m = _CVE_TAG_RE.search(prompt)
+    return m.group(1) if m else None
+
+
+def _common_codex_args(prompt: str, model: str) -> list[str]:
+    return [
+        "exec",
+        "--sandbox",
+        "danger-full-access",
+        "--json",
+        "--skip-git-repo-check",
+        "--model",
+        model,
+        prompt,
+    ]
+
+
+class CodexB1PrimeAgent(CodexAgent):
+    """B1' — frozen Codex behavior + full capture; no Izyan tools.
+
+    Registered as ``codex-b1p``. Everything the B1 adapter did is intact:
+    same image name pattern, same CLI args, same config mount. The only
+    deltas are protocol-level and shared with C1: the caller selects the
+    ``vuln_assess`` prompt and this class wires the existing
+    artifacts_dir/artifact_paths capture so stdout, stderr and the Codex
+    session records survive success, non-zero exit and timeout alike.
+    """
+
+    IMAGE_SUFFIX = "codex"  # vex-bench-<lang>-codex:latest — the frozen B1 image
+
+    def run(self, prompt: str, ctx: RunContext) -> AgentResult:
+        env_file = HOST_ENV_FILE.resolve()
+        if not env_file.exists():
+            raise RuntimeError(f"Env file not found: {env_file}")
+        config_file = HOST_CONFIG.resolve()
+        if not config_file.exists():
+            raise RuntimeError(f"Config file not found: {config_file}")
+
+        image = f"vex-bench-{ctx.language}-{self.IMAGE_SUFFIX}:latest"
+        logger.debug("running %s image=%s src=%s", type(self).__name__, image, ctx.cwd)
+        stdout = run_in_container(
+            image,
+            _common_codex_args(prompt, self.model),
+            entrypoint="codex",
+            src=ctx.cwd,
+            timeout=ctx.timeout,
+            env_file=env_file,
+            mounts=[(config_file, CONTAINER_CONFIG)],
+            artifacts_dir=ctx.artifacts_dir,
+            artifact_paths=self._artifact_paths(),
+            io_log_dir=(ctx.artifacts_dir / "logs") if ctx.artifacts_dir else None,
+        )
+        return AgentResult(raw_output=stdout)
+
+    def _artifact_paths(self) -> list[tuple[str, str]]:
+        """(container_path, dest_name) pairs exported after every attempt.
+
+        Missing paths are tolerated by the exporter (docker cp is
+        best-effort); absence is itself diagnostic. Only ``sessions``/
+        ``log`` are pulled — the whole $CODEX_HOME would drag in a
+        multi-MB plugin cache unrelated to the attempt.
+        """
+        return [
+            (f"{CODEX_STATE_DIR}/sessions", "codex-sessions"),  # rollouts incl. MCP events
+            (f"{CODEX_STATE_DIR}/log", "codex-log"),
+        ]
+
+
+class CodexC1Agent(CodexB1PrimeAgent):
+    """C1 — B1' plus the izyan MCP evidence-tools server.
+
+    Registered as ``codex-c1``. Requires the derived image
+    ``vex-bench-<lang>-codex-c1:latest`` carrying the tool binary; the MCP
+    session is configured by appending ``[mcp_servers.izyan]`` to the same
+    provider config B1 used, so model/provider settings are identical.
+    """
+
+    IMAGE_SUFFIX = "codex-c1"
+
+    def run(self, prompt: str, ctx: RunContext) -> AgentResult:
+        cve_id = _extract_cve_id(prompt)
+        if not cve_id:
+            raise RuntimeError(
+                "codex-c1: could not extract CVE id from prompt "
+                "(expected <CVE>...</CVE> tag)"
+            )
+        config_file = self._synthesize_config(ctx, cve_id)
+        env_file = HOST_ENV_FILE.resolve()
+        if not env_file.exists():
+            raise RuntimeError(f"Env file not found: {env_file}")
+        image = f"vex-bench-{ctx.language}-{self.IMAGE_SUFFIX}:latest"
+        logger.debug(
+            "running codex-c1 image=%s src=%s cve=%s", image, ctx.cwd, cve_id
+        )
+        stdout = run_in_container(
+            image,
+            _common_codex_args(prompt, self.model),
+            entrypoint="codex",
+            src=ctx.cwd,
+            timeout=ctx.timeout,
+            env_file=env_file,
+            mounts=[(config_file, CONTAINER_CONFIG)],
+            artifacts_dir=ctx.artifacts_dir,
+            artifact_paths=self._artifact_paths(),
+            io_log_dir=(ctx.artifacts_dir / "logs") if ctx.artifacts_dir else None,
+        )
+        return AgentResult(raw_output=stdout)
+
+    def _synthesize_config(self, ctx: RunContext, cve_id: str) -> Path:
+        """Provider config + [mcp_servers.izyan], written under artifacts_dir.
+
+        The MCP args pin the session to this attempt's snapshot (/work —
+        the docker-cp target), the task's CVE and a container-local audit
+        file. --allow-exec matches B1 parity (native sandbox already runs
+        arbitrary commands); advisory network research stays enabled, as it
+        was for B1. External SHA = snapshot dir basename (commit sha).
+        """
+        base_cfg = HOST_CONFIG.resolve().read_text(encoding="utf-8")
+        external_sha = ctx.cwd.name  # .../<owner>/<repo>/<commit_sha>
+        args = [
+            "--snapshot-root", "/work",
+            "--cve", cve_id,
+            "--external-sha", external_sha,
+            "--audit-file", f"{TOOL_AUDIT_DIR}/tool_calls.jsonl",
+            "--allow-exec",
+        ]
+        args_toml = "[" + ", ".join('"' + a + '"' for a in args) + "]"
+        cfg = (
+            base_cfg.rstrip()
+            + "\n\n[mcp_servers.izyan]\n"
+            + f'command = "{TOOL_BIN_CONTAINER}"\n'
+            + f"args = {args_toml}\n"
+        )
+        if ctx.artifacts_dir is None:
+            raise RuntimeError("codex-c1: RunContext.artifacts_dir is required")
+        ctx.artifacts_dir.mkdir(parents=True, exist_ok=True)
+        out = ctx.artifacts_dir / "codex-config.c1.toml"
+        out.write_text(cfg, encoding="utf-8")
+        return out
+
+    def _artifact_paths(self) -> list[tuple[str, str]]:
+        return super()._artifact_paths() + [
+            (TOOL_AUDIT_DIR, "izyan-audit"),  # tool_calls.jsonl observations
+        ]
