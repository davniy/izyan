@@ -0,0 +1,75 @@
+#!/usr/bin/env bash
+# Build the Task 4 C1 derived images: the frozen agent images plus the
+# izyan-evidence-tools MCP server binary.
+#
+#   ./build-c1.sh <izyan-checkout> [izyan-ref]
+#
+#   <izyan-checkout>  path to the Izyan repo worktree (must contain
+#                     cmd/izyan-evidence-tools); required.
+#   [izyan-ref]       optional recorded ref label stamped into the image
+#                     tag metadata file next to this script (informational;
+#                     the image tag stays :latest like the other agents).
+#
+# The binary is cross-compiled for the Docker host's architecture
+# (GOOS=linux, GOARCH from `docker info`). Keep the base image untouched:
+# B1 must be able to run the frozen vex-bench-go-codex:latest as before.
+#
+# C1_IMAGES optionally restricts the build to a subset, e.g.
+#   C1_IMAGES=opencode docker/build-c1.sh <izyan-checkout>
+# when the codex base image is not present locally. Default: both.
+set -euo pipefail
+
+HERE="$(cd "$(dirname "$0")" && pwd)"
+IZYAN="${1:?usage: build-c1.sh <izyan-checkout> [izyan-ref]}"
+REF="${2:-$(git -C "$IZYAN" describe --always --dirty --tags 2>/dev/null || git -C "$IZYAN" rev-parse --short HEAD 2>/dev/null || echo unknown)}"
+IMAGES="${C1_IMAGES:-codex opencode}"
+
+if [[ ! -d "$IZYAN/cmd/izyan-evidence-tools" ]]; then
+    echo "error: $IZYAN does not look like an izyan checkout" >&2
+    exit 1
+fi
+
+GOARCH="$(docker info --format '{{.Architecture}}')"
+# docker reports "aarch64" where Go wants "arm64"
+GOARCH="${GOARCH/aarch64/arm64}"
+mkdir -p "$HERE/bin"
+
+echo ">>> building izyan-evidence-tools (izyan@$REF, linux/$GOARCH)"
+(cd "$IZYAN" && GOOS=linux GOARCH="$GOARCH" CGO_ENABLED=0 \
+    go build -trimpath -o "$HERE/bin/izyan-evidence-tools" ./cmd/izyan-evidence-tools)
+
+BUILT=()
+BASES=()
+if [[ " $IMAGES " == *" codex "* ]]; then
+    echo ">>> building vex-bench-go-codex-c1"
+    docker build -t "vex-bench-go-codex-c1:latest" \
+        -f "$HERE/go.codex-c1.Dockerfile" "$HERE"
+    BUILT+=("vex-bench-go-codex-c1:latest")
+    BASES+=("vex-bench-go-codex:latest")
+fi
+
+# opencode variant: built on the custom image so self-hosted providers
+# (custom-openai) keep working through the corporate CA.
+if [[ " $IMAGES " == *" opencode "* ]]; then
+    echo ">>> building vex-bench-go-opencode-c1"
+    docker build -t "vex-bench-go-opencode-c1:latest" \
+        -f "$HERE/go.opencode-c1.Dockerfile" "$HERE"
+    BUILT+=("vex-bench-go-opencode-c1:latest")
+    BASES+=("vex-bench-go-opencode-custom:latest")
+fi
+
+if [[ ${#BUILT[@]} -eq 0 ]]; then
+    echo "error: C1_IMAGES selected no image (got '$IMAGES')" >&2
+    exit 1
+fi
+
+cat > "$HERE/c1-image.stamp" <<EOF
+images=$(IFS=,; echo "${BUILT[*]}")
+bases=$(IFS=,; echo "${BASES[*]}")
+izyan_checkout=$IZYAN
+izyan_ref=$REF
+built_at=$(date -u +%Y-%m-%dT%H:%M:%SZ)
+binary_sha256=$(shasum -a 256 "$HERE/bin/izyan-evidence-tools" | awk '{print $1}')
+EOF
+
+echo ">>> done; stamp written to $HERE/c1-image.stamp"
diff --git a/docker/go.codex-c1.Dockerfile b/docker/go.codex-c1.Dockerfile
new file mode 100644
index 0000000..8c846ca
--- /dev/null
+++ b/docker/go.codex-c1.Dockerfile
@@ -0,0 +1,10 @@
+# Task 4 (C1) image: frozen B1 Codex image + izyan evidence-tools binary.
+#
+# Build context is the directory produced by docker/build-c1.sh, which
+# cross-compiles izyan-evidence-tools from a pinned izyan checkout into
+# this directory (bin/izyan-evidence-tools). Nothing else changes:
+# ENTRYPOINT [codex], base Go toolchain and Codex 0.131.0 are inherited.
+FROM vex-bench-go-codex:latest
+
+COPY bin/izyan-evidence-tools /usr/local/bin/izyan-evidence-tools
+RUN chmod 0755 /usr/local/bin/izyan-evidence-tools
