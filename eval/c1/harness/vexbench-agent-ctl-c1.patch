index 0000000..a45d3fe
--- /dev/null
+++ b/src/evaluate/agents/opencode_c1.py
@@ -0,0 +1,242 @@
+"""Task 4 OpenCode adapters — ``opencode-b1p`` and ``opencode-c1``.
+
+Mirrors ``codex_c1.py``: two registry entries that share one run path.
+
+- ``opencode-b1p`` (B1' control): the frozen opencode profile — same
+  model wiring, native tools untouched, session export and debug
+  artifacts identical — on the corp image
+  ``vex-bench-<lang>-opencode-gw:latest`` so the corporate CA is
+  present for self-hosted providers (custom-openai). The caller selects the
+  ``vuln_assess`` prompt; there are no Izyan tools anywhere.
+
+- ``opencode-c1`` (C1 treatment): B1' + the izyan MCP evidence-tools
+  server. The derived image
+  ``vex-bench-<lang>-opencode-c1:latest``
+  (docker/go.opencode-c1.Dockerfile) adds the tool binary; per attempt
+  the adapter synthesizes ``opencode.json`` — the base provider file
+  plus the needed provider block when the base file lacks it
+  (antigravity points at the host-side proxy via host.docker.internal)
+  plus ``mcp.izyan`` pinned to this attempt's snapshot (``/work`` — the
+  docker-cp target), the task's CVE and a container-local audit file,
+  exported as ``artifacts/izyan-audit/``.
+
+Both arms mount a synthesized per-attempt config under artifacts_dir;
+the ONLY difference between the two files is the ``mcp`` block, so the
+treatment variable is exactly the evidence tools. Native opencode tools
+are untouched: the base config carries no tool restrictions and the
+synthesized config adds none. Model keys are the full provider-side
+model ids (e.g. ``Qwen/Qwen3.6-35B-A3B``) — opencode sends the config
+key verbatim to the API.
+"""
+
+import json
+import logging
+from pathlib import Path
+from typing import Optional, Sequence
+
+from evaluate.agents.base import AgentResult, RunContext
+from evaluate.agents.codex_c1 import (
+    TOOL_AUDIT_DIR,
+    TOOL_BIN_CONTAINER,
+    _extract_cve_id,
+)
+from evaluate.agents.opencode import (
+    HOST_CONFIG,
+    HOST_ENV_FILE,
+    OpenCodeAgent,
+    _run_opencode_and_export,
+)
+
+logger = logging.getLogger(__name__)
+
+# Provider blocks merged into the synthesized opencode.json when the base
+# file doesn't define them (``setdefault`` — an explicit base config always
+# wins). Keyed by the provider prefix of MODEL2NAME values.
+_PROVIDERS: dict[str, dict] = {
+    # Host-side antigravity proxy (Anthropic-compatible). The proxy ignores
+    # the api key; a literal keeps the SDK's key requirement satisfied
+    # without adding secrets to the env file.
+    "antigravity": {
+        "npm": "@ai-sdk/anthropic",
+        "name": "antigravity",
+        "options": {
+            "baseURL": "http://host.docker.internal:8045/v1",
+            "apiKey": "opencode-c1",
+        },
+        "models": {
+            "gemini-3.8-flash-high": {"name": "Gemini 3.8 Flash High"},
+        },
+    },
+    # OpenAI-compatible gateway. apiKey is interpolated from the
+    # env file at container start — the synthesized config is an attempt
+    # artifact and must not embed the literal secret (same convention as
+    # codex's ``env_key`` indirection).
+    "custom-openai": {
+        "npm": "@ai-sdk/openai-compatible",
+        "name": "OpenAI-compatible gateway",
+        "api_key_env": "OPENAI_API_KEY",
+        "options": {
+            "baseURL": "https://<corporate-provider-host>/openai/v1/",
+        },
+        "models": {
+            "Qwen/Qwen3.6-35B-A3B": {
+                "name": "Qwen3.6-35B-A3B",
+                "limit": {"context": 262144, "output": 16384},
+            },
+            "Qwen/Qwen3.8-27B": {
+                "name": "Qwen3.8-27B",
+                "limit": {"context": 262144, "output": 16384},
+            },
+        },
+    },
+}
+
+
+class OpenCodeB1PrimeAgent(OpenCodeAgent):
+    """B1' — frozen opencode behavior + assessment prompt; no Izyan tools.
+
+    Registered as ``opencode-b1p``. Same run pipeline, session export and
+    debug artifacts as the base ``opencode`` profile; the image is the
+    corp variant so the corporate CA covers self-hosted providers. The
+    mounted config is a per-attempt synthesis under artifacts_dir —
+    provider wiring identical to ``opencode-c1``, ``mcp`` block absent.
+    """
+
+    IMAGE_SUFFIX = "opencode-gw"  # vex-bench-<lang>-opencode-gw:latest
+    CONFIG_TAG = "b1p"              # artifacts/opencode-config.<tag>.json
+
+    def run(self, prompt: str, ctx: RunContext) -> AgentResult:
+        return self._run_attempt(prompt, ctx, cve_id=None)
+
+    def _run_attempt(self, prompt: str, ctx: RunContext,
+                     cve_id: Optional[str]) -> AgentResult:
+        config_file = self._synthesize_config(ctx, cve_id)
+        env_file = HOST_ENV_FILE.resolve()
+        if not env_file.exists():
+            raise RuntimeError(f"Env file not found: {env_file}")
+
+        image = f"vex-bench-{ctx.language}-{self.IMAGE_SUFFIX}:latest"
+        logger.debug(
+            "running %s model=%s image=%s src=%s cve=%s",
+            type(self).__name__, self.model_name, image, ctx.cwd, cve_id,
+        )
+        output = _run_opencode_and_export(
+            image,
+            model=self.model_name,
+            prompt=prompt,
+            src=ctx.cwd,
+            timeout=ctx.timeout,
+            env_file=env_file,
+            config_file=config_file,
+            artifacts_dir=ctx.artifacts_dir,
+            extra_artifact_paths=self._extra_artifact_paths(),
+        )
+        return AgentResult(raw_output=output)
+
+    def _extra_artifact_paths(self) -> Sequence[tuple[str, str]]:
+        """(container_path, dest_name) pairs exported after every attempt.
+
+        Missing paths are tolerated by the exporter; absence is itself
+        diagnostic (B1' proves the negative: no izyan-audit exists).
+        """
+        return [(TOOL_AUDIT_DIR, "izyan-audit")]
+
+    def _extend_config(self, base: dict, ctx: RunContext,
+                       cve_id: Optional[str]) -> None:
+        """B1' adds nothing — ``mcp`` stays absent; the synthesized
+        config differs from C1's by exactly the tools block."""
+
+    def _synthesize_config(self, ctx: RunContext,
+                           cve_id: Optional[str]) -> Path:
+        """Base provider config + provider block (if absent) + arm delta.
+
+        Written under artifacts_dir so the effective config is an attempt
+        artifact — same convention as codex-c1's codex-config.c1.toml.
+        """
+        base = json.loads(HOST_CONFIG.resolve().read_text(encoding="utf-8"))
+        providers = base.setdefault("provider", {})
+
+        provider_name, _, model_key = self.model_name.partition("/")
+        snippet = _PROVIDERS.get(provider_name)
+        if snippet is not None:
+            entry = providers.setdefault(provider_name, {})
+            entry.setdefault("npm", snippet["npm"])
+            entry.setdefault("name", snippet["name"])
+            options = entry.setdefault("options", {})
+            for k, v in snippet["options"].items():
+                options.setdefault(k, v)
+            api_key_env = snippet.get("api_key_env")
+            if api_key_env:
+                # Always rewrite a literal key to env interpolation — the
+                # synthesized file is exported as an attempt artifact.
+                options["apiKey"] = f"{{env:{api_key_env}}}"
+            models = entry.setdefault("models", {})
+            models.setdefault(
+                model_key,
+                snippet["models"].get(model_key, {"name": model_key}),
+            )
+        else:
+            logger.warning(
+                "%s: no built-in provider snippet for %r; "
+                "relying on the base config",
+                self.CONFIG_TAG, provider_name,
+            )
+
+        self._extend_config(base, ctx, cve_id)
+
+        if ctx.artifacts_dir is None:
+            raise RuntimeError(
+                f"{self.CONFIG_TAG}: RunContext.artifacts_dir is required")
+        ctx.artifacts_dir.mkdir(parents=True, exist_ok=True)
+        out = ctx.artifacts_dir / f"opencode-config.{self.CONFIG_TAG}.json"
+        out.write_text(json.dumps(base, indent=2) + "\n", encoding="utf-8")
+        return out
+
+
+class OpenCodeC1Agent(OpenCodeB1PrimeAgent):
+    """C1 — B1' plus the izyan MCP evidence-tools server.
+
+    Registered as ``opencode-c1``. Requires the derived image
+    ``vex-bench-<lang>-opencode-c1:latest`` carrying the tool binary;
+    the synthesized config adds the ``mcp.izyan`` server pinned to this
+    attempt's snapshot and CVE, and the audit dir is exported as
+    ``artifacts/izyan-audit/``.
+    """
+
+    IMAGE_SUFFIX = "opencode-c1"
+    CONFIG_TAG = "c1"
+
+    def run(self, prompt: str, ctx: RunContext) -> AgentResult:
+        cve_id = _extract_cve_id(prompt)
+        if not cve_id:
+            raise RuntimeError(
+                "opencode-c1: could not extract CVE id from prompt "
+                "(expected <CVE>...</CVE> tag)"
+            )
+        return self._run_attempt(prompt, ctx, cve_id)
+
+    def _extend_config(self, base: dict, ctx: RunContext,
+                       cve_id: Optional[str]) -> None:
+        if cve_id is None:
+            raise RuntimeError("opencode-c1: cve_id is required")
+        # The container runs via ``sh -lc``: the login shell resets PATH
+        # through /etc/profile (Debian root → /usr/local/sbin:... only),
+        # which drops /usr/local/go/bin and /go/bin from the MCP server's
+        # environment. The evidence tools exec `go` — pin PATH explicitly
+        # (opencode "environment" merges over the inherited env).
+        base["mcp"] = {
+            "izyan": {
+                "type": "local",
+                "command": [
+                    TOOL_BIN_CONTAINER,
+                    "--snapshot-root", "/work",
+                    "--cve", cve_id,
+                    "--audit-file", f"{TOOL_AUDIT_DIR}/tool_calls.jsonl",
+                ],
+                "environment": {
+                    "PATH": "/go/bin:/usr/local/go/bin:/usr/local/sbin:"
+                            "/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
+                },
+                "enabled": True,
+            }
+        }
